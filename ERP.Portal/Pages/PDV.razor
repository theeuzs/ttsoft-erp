@page "/pdv"
@using ERP.Portal.Services
@inject ApiClient Api
@inject AuthService Auth
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* =========================================================
       PDV
       ========================================================= */

    .pdv-page {
        height: calc(100vh - 54px);
        overflow: hidden;
        background: #F1F5F9;
    }

    .pdv-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 390px;
        height: 100%;
    }

    /* =========================================================
       PRODUTOS
       ========================================================= */

    .pdv-produtos {
        min-width: 0;
        padding: 18px;
        overflow-y: auto;
        background: #F1F5F9;
    }

    .pdv-topbar {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .pdv-search {
        flex: 1;
        min-width: 0;
        height: 48px;
        padding: 0 16px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: white;
        font-size: 15px;
        outline: none;
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }

    .pdv-search:focus {
        border-color: #1E62A6;
        box-shadow: 0 0 0 3px rgba(30,98,166,.10);
    }

    .pdv-filter {
        height: 48px;
        padding: 0 15px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: white;
        color: #475569;
        font-weight: 700;
        cursor: pointer;
    }

    .produtos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
        gap: 12px;
    }

    .produto-card {
        background: white;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 14px;
        min-height: 125px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(15,23,42,.05);
        transition:
            transform .12s ease,
            border-color .12s ease,
            box-shadow .12s ease,
            background .12s ease;
        user-select: none;
    }

    .produto-card:hover {
        border-color: #1E62A6;
        background: #F8FBFF;
        box-shadow: 0 5px 16px rgba(15,23,42,.08);
    }

    .produto-card:active {
        transform: scale(.97);
    }

    .produto-card.flash {
        border-color: #10B981 !important;
        background: #ECFDF5 !important;
        transform: scale(.98);
    }

    .produto-codigo {
        font-size: 10px;
        color: #94A3B8;
        margin-bottom: 6px;
        font-family: monospace;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .produto-nome {
        font-size: 13px;
        font-weight: 750;
        line-height: 1.35;
        color: #1E293B;
        min-height: 36px;
    }

    .produto-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
    }

    .produto-preco {
        font-size: 17px;
        font-weight: 850;
        color: #1E62A6;
        white-space: nowrap;
    }

    .produto-estoque {
        font-size: 10px;
        font-weight: 750;
        padding: 4px 7px;
        border-radius: 6px;
        white-space: nowrap;
    }

    /* =========================================================
       CARRINHO DESKTOP
       ========================================================= */

    .pdv-carrinho {
        background: white;
        display: flex;
        flex-direction: column;
        min-width: 0;
        border-left: 1px solid #E2E8F0;
        box-shadow: -5px 0 18px rgba(15,23,42,.04);
        z-index: 20;
    }

    .carrinho-header {
        padding: 17px;
        border-bottom: 1px solid #F1F5F9;
    }

    .carrinho-titulo {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .carrinho-titulo strong {
        font-size: 17px;
        color: #1E293B;
    }

    .limpar-btn {
        border: 0;
        background: transparent;
        color: #EF4444;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .cliente-box {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .cliente-input {
        flex: 1;
        min-width: 0;
        height: 40px;
        padding: 0 11px;
        border: 1px solid #E2E8F0;
        border-radius: 9px;
        font-size: 13px;
        outline: none;
    }

    .cliente-search {
        width: 42px;
        border: 0;
        border-radius: 9px;
        background: #F1F5F9;
        cursor: pointer;
    }

    .carrinho-lista {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }

    .carrinho-vazio {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 30px;
        color: #94A3B8;
        font-size: 13px;
    }

    .carrinho-vazio-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 12px;
    }

    .carrinho-item {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px;
        padding: 13px 16px;
        border-bottom: 1px solid #F1F5F9;
    }

    .item-info {
        min-width: 0;
    }

    .item-nome {
        font-size: 13px;
        font-weight: 700;
        color: #1E293B;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .item-preco {
        margin-top: 3px;
        color: #64748B;
        font-size: 11px;
    }

    .item-total {
        text-align: right;
        font-size: 14px;
        font-weight: 850;
        color: #1E293B;
    }

    .item-controles {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .qtd-btn {
        width: 34px;
        height: 32px;
        border: 1px solid #E2E8F0;
        background: white;
        border-radius: 8px;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
    }

    .qtd-btn:active {
        background: #F1F5F9;
    }

    .qtd {
        min-width: 35px;
        text-align: center;
        font-size: 14px;
        font-weight: 800;
    }

    .remover-btn {
        margin-left: auto;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 8px;
        background: #FEF2F2;
        color: #EF4444;
        cursor: pointer;
    }

    /* =========================================================
       RODAPÉ CARRINHO
       ========================================================= */

    .carrinho-footer {
        border-top: 2px solid #E2E8F0;
        background: #FAFAFA;
        padding: 14px 16px;
    }

    .desconto-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .desconto-row label {
        font-size: 12px;
        font-weight: 700;
        color: #64748B;
    }

    .desconto-input {
        width: 100px;
        height: 34px;
        padding: 0 8px;
        border: 1px solid #E2E8F0;
        border-radius: 7px;
    }

    .subtotal-row,
    .desconto-total-row {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .subtotal-row {
        color: #64748B;
    }

    .desconto-total-row {
        color: #EF4444;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 10px 0 14px;
    }

    .total-label {
        font-size: 18px;
        font-weight: 850;
        color: #1E293B;
    }

    .total-valor {
        font-size: 25px;
        font-weight: 900;
        color: #1E293B;
        transition: color .3s ease;
    }

    .total-valor.mudou {
        color: #10B981 !important;
    }

    .pagamentos {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
        margin-bottom: 10px;
    }

    .pagamento-btn {
        min-height: 42px;
        border: 2px solid #E2E8F0;
        border-radius: 9px;
        background: white;
        color: #64748B;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
    }

    .pagamento-btn.ativo {
        border-color: #1E62A6;
        background: #EFF6FF;
        color: #1E62A6;
    }

    .finalizar-btn {
        width: 100%;
        height: 52px;
        border: 0;
        border-radius: 11px;
        color: white;
        font-size: 15px;
        font-weight: 850;
        cursor: pointer;
    }

    /* =========================================================
       BARRA MOBILE
       ========================================================= */

    .mobile-carrinho-bar {
        display: none;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .pdv-page {
            height: calc(100vh - 54px);
        }

        .pdv-grid {
            display: block;
            height: 100%;
        }

        .pdv-produtos {
            height: 100%;
            padding: 10px 10px 85px;
        }

        .pdv-topbar {
            margin-bottom: 10px;
        }

        .pdv-search {
            height: 50px;
            font-size: 16px;
            border-radius: 13px;
        }

        .pdv-filter {
            width: 48px;
            padding: 0;
            font-size: 0;
        }

        .pdv-filter::after {
            content: "☰";
            font-size: 19px;
        }

        .produtos-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
        }

        .produto-card {
            padding: 12px;
            min-height: 122px;
            border-radius: 12px;
        }

        .produto-nome {
            font-size: 12px;
        }

        .produto-preco {
            font-size: 15px;
        }

        .produto-estoque {
            display: none;
        }

        /* Carrinho vira tela inteira */
        .pdv-carrinho {
            position: fixed;
            inset: 0;
            height: 100dvh;
            width: 100%;
            z-index: 100;
            border: 0;
            transform: translateX(100%);
            transition: transform .22s ease;
        }

        .pdv-carrinho.aberto {
            transform: translateX(0);
        }

        .carrinho-header {
            padding-top: max(14px, env(safe-area-inset-top));
        }

        .carrinho-voltar {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 0;
            background: transparent;
            color: #64748B;
            font-weight: 700;
            margin-bottom: 8px;
            padding: 0;
            font-size: 14px;
            cursor: pointer;
        }

        .carrinho-footer {
            padding-bottom: max(14px, env(safe-area-inset-bottom));
        }

        /* Barra fixa inferior */
        .mobile-carrinho-bar {
            position: fixed;
            display: flex;
            align-items: center;
            gap: 10px;
            left: 10px;
            right: 10px;
            bottom: max(10px, env(safe-area-inset-bottom));
            height: 62px;
            padding: 7px 8px 7px 14px;
            background: #1E293B;
            border-radius: 15px;
            box-shadow: 0 8px 30px rgba(15,23,42,.25);
            z-index: 80;
            color: white;
        }

        .mobile-carrinho-info {
            flex: 1;
            min-width: 0;
        }

        .mobile-carrinho-qtd {
            font-size: 11px;
            color: #CBD5E1;
        }

        .mobile-carrinho-total {
            font-size: 17px;
            font-weight: 850;
        }

        .mobile-carrinho-button {
            height: 48px;
            padding: 0 15px;
            border: 0;
            border-radius: 11px;
            background: #1E62A6;
            color: white;
            font-size: 12px;
            font-weight: 850;
            cursor: pointer;
        }

        .mobile-fechar {
            display: block;
        }
    }

    @@media (min-width: 769px) {
        .carrinho-voltar,
        .mobile-fechar {
            display: none;
        }
    }
</style>

<!-- Beep invisível para erro de barcode (S3.5) -->
<audio id="beep-erro" src="data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAA..." preload="auto" style="display:none"></audio>

<!-- ── Modal: Produtos Agregados ───────────────────────────────────────────── -->
@if (_agregados.Count > 0)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:200;
                display:flex; align-items:center; justify-content:center;"
         @onclick="FecharAgregados">
        <div style="background:white; border-radius:16px; padding:24px; max-width:480px;
                    width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3);"
             @onclick:stopPropagation>
            <div style="font-size:16px; font-weight:800; color:#1E293B; margin-bottom:4px;">
                📦 Produtos frequentemente comprados juntos
            </div>
            <div style="font-size:12px; color:#94A3B8; margin-bottom:16px;">
                Clientes que levaram <strong>@_agregadoPai</strong> também levaram:
            </div>
            @foreach (var ag in _agregados)
            {
                <div style="display:flex; align-items:center; gap:12px; padding:10px 0;
                            border-bottom:1px solid #F1F5F9;">
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:13px; color:#1E293B;">@ag.Nome</div>
                        <div style="font-size:12px; color:#94A3B8;">@ag.Preco.ToString("C") por @ag.Unit</div>
                    </div>
                    <button @onclick="() => AdicionarAgregado(ag)"
                            style="background:#1E62A6; color:white; border:none; padding:8px 14px;
                                   border-radius:8px; font-weight:700; font-size:12px; cursor:pointer;">
                        + Adicionar
                    </button>
                </div>
            }
            <button @onclick="FecharAgregados"
                    style="width:100%; margin-top:16px; background:#F1F5F9; border:none;
                           padding:12px; border-radius:8px; font-weight:600; cursor:pointer;
                           color:#64748B; font-size:13px;">
                Não, obrigado
            </button>
        </div>
    </div>
}

<!-- ── Modal: Opção Fiscal ao Finalizar ───────────────────────────────────── -->
@if (_modalFiscal)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:200;
                display:flex; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:16px; padding:28px; max-width:440px;
                    width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3);">
            <div style="font-size:17px; font-weight:800; color:#1E293B; margin-bottom:6px;">
                🧾 Emitir nota fiscal?
            </div>
            <div style="font-size:13px; color:#94A3B8; margin-bottom:20px;">
                Venda de @Total.ToString("C"). Escolha o tipo de documento ou pule.
            </div>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <button @onclick="ConfirmarNfce"
                        style="padding:14px; background:#1E62A6; color:white; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">📱</span>
                    <div>
                        <div>NFC-e — Nota Fiscal do Consumidor</div>
                        <div style="font-size:11px; opacity:.8;">Para consumidor final · emissão imediata</div>
                    </div>
                </button>
                <button @onclick="ConfirmarNfe"
                        style="padding:14px; background:#7C3AED; color:white; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">📄</span>
                    <div>
                        <div>NF-e — Nota Fiscal Eletrônica</div>
                        <div style="font-size:11px; opacity:.8;">Para CNPJ ou valor alto</div>
                    </div>
                </button>
                <button @onclick="ConfirmarSemNota"
                        style="padding:14px; background:#F1F5F9; color:#64748B; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">🧾</span>
                    <div>
                        <div>Sem nota / Recibo simples</div>
                        <div style="font-size:11px; opacity:.8;">Finalizar sem emissão fiscal</div>
                    </div>
                </button>
            </div>
            <button @onclick="FecharModalFiscal"
                    style="width:100%; margin-top:12px; background:transparent; border:none;
                           color:#94A3B8; cursor:pointer; font-size:12px;">
                Cancelar
            </button>
        </div>
    </div>
}

<!-- ── Mensagem Toast (Sucesso/Erro) ──────────────────────────────────────── -->
@if (_mensagem != null)
{
    <div style="position:fixed; top:70px; left:50%; transform:translateX(-50%);
         background:@(_sucesso ? "#27AE60" : "#EF4444"); color:white; padding:14px 28px;
         border-radius:12px; font-size:15px; font-weight:700; z-index:500;
         box-shadow:0 4px 20px rgba(0,0,0,.2);">
        @_mensagem
    </div>
}

<div class="pdv-page">
    <div class="pdv-grid">

        <!-- =====================================================
             PRODUTOS
             ===================================================== -->
        <div class="pdv-produtos">
            <div class="pdv-topbar">
                <input class="pdv-search"
                       @bind="_busca"
                       @bind:event="oninput"
                       @onkeyup="BuscarProdutos"
                       placeholder="🔎 Buscar produto ou código..." />

                <button class="pdv-filter" @onclick="AbrirScanner" title="Ler código de barras pela câmera"
                        style="padding:8px 12px;">
                    📷
                </button>

                <button class="pdv-filter" @onclick="ToggleMostrarTodos">
                    @(_mostrarTodos ? "Menos" : "📦 Todos")
                </button>
            </div>

            @if (_loadingProdutos)
            {
                <div style="text-align:center;padding:50px;color:#94A3B8;">
                    Carregando produtos...
                </div>
            }
            else
            {
                <div class="produtos-grid">
                    @foreach (var p in _produtos ?? [])
                    {
                        var flashClass = _flashProdutoId == p.Id ? "produto-card flash" : "produto-card";

                        <div class="@flashClass" @onclick="() => AdicionarItemAsync(p)">
                            @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name"
                                     style="width:100%; height:90px; object-fit:cover; border-radius:8px 8px 0 0; margin-bottom:6px;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div style="width:100%; height:90px; display:flex; align-items:center; justify-content:center;
                                            background:#F1F5F9; border-radius:8px 8px 0 0; margin-bottom:6px; font-size:28px;">
                                    📦
                                </div>
                            }
                            <div class="produto-codigo">
                                @(p.Barcode ?? p.Sku ?? "Sem código")
                            </div>

                            <div class="produto-nome">
                                @(p.Name.Length > 45 ? p.Name[..45] + "…" : p.Name)
                            </div>

                            <div class="produto-bottom">
                                <span class="produto-preco">
                                    @p.SalePrice.ToString("C")
                                </span>

                                <span class="produto-estoque"
                                      style="color:@(p.Stock > 0 ? "#059669" : "#DC2626");
                                             background:@(p.Stock > 0 ? "#D1FAE5" : "#FEE2E2");">
                                    @(p.Stock > 0 ? $"{p.Stock:F0} {p.Unit}" : "Sem estoque")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- =====================================================
             CARRINHO
             ===================================================== -->
        <div class="pdv-carrinho @(_carrinhoAberto ? "aberto" : "")">
            <div class="carrinho-header">
                <button class="carrinho-voltar" @onclick="FecharCarrinho">
                    ← Voltar
                </button>

                <div class="carrinho-titulo">
                    <strong>🛒 Carrinho</strong>
                    @if (_itens.Any())
                    {
                        <button class="limpar-btn" @onclick="LimparCarrinho">
                            Limpar
                        </button>
                    }
                </div>

                <div class="cliente-box">
                    <input class="cliente-input"
                           @bind="_nomeCliente"
                           placeholder="Cliente (opcional)" />
                    <button class="cliente-search" @onclick="BuscarClienteAsync">
                        🔎
                    </button>
                </div>
            </div>

            <!-- LISTA -->
            <div class="carrinho-lista">
                @if (!_itens.Any())
                {
                    <div class="carrinho-vazio">
                        <div class="carrinho-vazio-icon">🛒</div>
                        <strong>Carrinho vazio</strong>
                        <span style="margin-top:5px;">Toque em um produto para adicionar</span>
                    </div>
                }
                else
                {
                    @foreach (var item in _itens)
                    {
                        var isNovo = _ultimoItemId == item.ProdutoId;

                        <div class="carrinho-item @(isNovo ? "novo" : "")">
                            <div class="item-info">
                                <div class="item-nome">@item.Nome</div>
                                <div class="item-preco">
                                    @item.PrecoUnitario.ToString("C") × @item.Quantidade
                                </div>
                            </div>
                            <div class="item-total">
                                @item.Total.ToString("C")
                            </div>

                            <div class="item-controles">
                                <button class="qtd-btn" @onclick="() => AlterarQtd(item, -1)">−</button>
                                <span class="qtd">@item.Quantidade</span>
                                <button class="qtd-btn" @onclick="() => AlterarQtd(item, 1)">+</button>
                                <button class="remover-btn" @onclick="() => RemoverItem(item)">✕</button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- =================================================
                 FOOTER DO CARRINHO
                 ================================================= -->
            <div class="carrinho-footer">
                @if (_itens.Any())
                {
                    <div class="desconto-row">
                        <label>Desconto</label>
                        <input class="desconto-input"
                               type="number"
                               value="@_desconto"
                               @oninput="ValidarDesconto"
                               min="0"
                               step="0.50" />
                        <span>R$</span>
                    </div>

                    @if (_erroDesconto != null)
                    {
                        <div style="font-size:11px; color:#DC2626; font-weight:700; background:#FEF2F2;
                                    padding:7px 9px; border-radius:7px; margin-bottom:8px;">
                            🚫 @_erroDesconto
                        </div>
                    }
                    @if (_maxDesconto > 0 && _erroDesconto == null)
                    {
                        <div style="font-size:11px; color:#94A3B8; margin-bottom:8px;">
                            Limite: @_maxDesconto.ToString("F0")% (@(Subtotal * _maxDesconto / 100).ToString("C"))
                        </div>
                    }

                    <div class="subtotal-row">
                        <span>Subtotal</span>
                        <span>@Subtotal.ToString("C")</span>
                    </div>

                    @if (_desconto > 0)
                    {
                        <div class="desconto-total-row">
                            <span>Desconto</span>
                            <span>-@_desconto.ToString("C")</span>
                        </div>
                    }

                    <div class="total-row">
                        <span class="total-label">TOTAL</span>
                        <span class="total-valor @(_totalAnimando ? "mudou" : "")">
                            @Total.ToString("C")
                        </span>
                    </div>

                    <!-- PAGAMENTOS -->
                    <div class="pagamentos">
                        @foreach (var (forma, icone) in new[] {
                            ("Dinheiro","💵"), ("Cartão Débito","💳"),
                            ("Cartão Crédito","💳"), ("PIX","📲"), ("Fiado","📋")
                        })
                        {
                            <button class="pagamento-btn @(_formaPagamento == forma ? "ativo" : "")"
                                    @onclick="@(() => _formaPagamento = forma)">
                                @icone @forma
                            </button>
                        }
                    </div>

                    <button class="finalizar-btn"
                            @onclick="AbrirModalFiscal"
                            disabled="@(_finalizando || _erroDesconto != null)"
                            style="background:@(_erroDesconto != null ? "#94A3B8" : "#16A34A");">
                        @(_finalizando ? "⏳ Finalizando..." : $"✓ Finalizar Venda · {Total.ToString("C")}")
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- =========================================================
         BARRA MOBILE INFERIOR (Aciona o Carrinho)
         ========================================================= -->
    @if (_itens.Any())
    {
        <div class="mobile-carrinho-bar">
            <div class="mobile-carrinho-info">
                <div class="mobile-carrinho-qtd">
                    @QuantidadeItens @(QuantidadeItens == 1 ? "item" : "itens")
                </div>
                <div class="mobile-carrinho-total">
                    @Total.ToString("C")
                </div>
            </div>
            <button class="mobile-carrinho-button" @onclick="AbrirCarrinho">
                VER CARRINHO →
            </button>
        </div>
    }
</div>

@if (_scannerAberto)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:2000;
                display:flex; flex-direction:column; align-items:center; justify-content:center;">
        <div style="color:white; font-weight:700; margin-bottom:12px;">
            📷 Aponte a câmera pro código de barras
        </div>
        <video id="video-scanner" style="width:90%; max-width:480px; border-radius:12px;
               background:black;" muted playsinline></video>
        @if (_erroScanner != null)
        {
            <div style="color:#FCA5A5; background:#7F1D1D; padding:10px 16px; border-radius:8px;
                        margin-top:12px; max-width:90%; text-align:center; font-size:13px;">
                ⚠ @_erroScanner
            </div>
        }
        <button @onclick="FecharScanner"
                style="margin-top:20px; background:#EF4444; color:white; border:none;
                       padding:12px 28px; border-radius:8px; font-weight:700; cursor:pointer;">
            Cancelar
        </button>
    </div>
}

<script src="lib/zxing.min.js"></script>
<script src="js/barcode-scanner.js"></script>

@code {
    // ── Leitor de código de barras via câmera ───────────────────────────────
    private bool                             _scannerAberto;
    private string?                          _erroScanner;
    private DotNetObjectReference<PDV>?      _scannerRef;

    private async Task AbrirScanner()
    {
        _erroScanner    = null;
        _scannerAberto  = true;
        StateHasChanged();

        // Espera o <video> existir no DOM antes de pedir a câmera pra ele.
        await Task.Delay(50);

        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("iniciarScannerCodigoBarras", "video-scanner", _scannerRef);
    }

    private async Task FecharScanner()
    {
        await JS.InvokeVoidAsync("pararScannerCodigoBarras");
        _scannerRef?.Dispose();
        _scannerRef    = null;
        _scannerAberto = false;
        _erroScanner   = null;
    }

    [JSInvokable]
    public async Task OnCodigoLido(string codigo)
    {
        await FecharScanner();
        _busca = codigo;
        await CarregarProdutosAsync(codigo);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnErroScanner(string mensagem)
    {
        _erroScanner = mensagem.Contains("Permission", StringComparison.OrdinalIgnoreCase)
            ? "Permissão de câmera negada. Habilite o acesso à câmera nas configurações do navegador."
            : $"Não foi possível acessar a câmera: {mensagem}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_scannerAberto)
        {
            try { await JS.InvokeVoidAsync("pararScannerCodigoBarras"); }
            catch (Exception ex) { Console.WriteLine($"PDV: falha ao parar scanner no dispose — {ex.Message}"); }
        }
        _scannerRef?.Dispose();
    }

    private ProdutoItem[]?     _produtos;
    private string             _busca            = "";
    // Achado (10/09) — busca disparava a cada tecla, sem debounce, e sem
    // checar se a resposta ainda correspondia ao texto atual. Respostas
    // fora de ordem faziam a lista "mudar sozinha" enquanto digitava.
    private int                _buscaSequencia   = 0;
    private bool               _mostrarTodos     = false;
    private bool               _loadingProdutos  = true;
    private List<ItemCarrinho> _itens            = new();
    private string             _nomeCliente      = "";
    private Guid?              _clienteId;
    private decimal            _desconto         = 0;
    private string             _formaPagamento   = "Dinheiro";
    private bool               _finalizando      = false;
    private string?            _mensagem;
    private bool               _sucesso          = true;
    private bool               _modalFiscal      = false;

    // S3.3: limite de desconto por cargo
    private decimal _maxDesconto  = 100; // % — padrão antes de carregar o cargo
    private string? _erroDesconto;

    // S3.5: feedback visual
    private Guid?  _flashProdutoId;
    private Guid?  _ultimoItemId;
    private bool   _totalAnimando = false;

    // Produtos Agregados
    private List<AgregadoItem> _agregados   = [];
    private string             _agregadoPai = "";

    // Mobile UX
    private bool _carrinhoAberto = false;

    private decimal Subtotal => _itens.Sum(i => i.Total);
    private decimal Total    => Math.Max(0, Subtotal - _desconto);
    private int QuantidadeItens => (int)_itens.Sum(i => i.Quantidade);

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutosAsync();
        await CarregarLimiteDescontoAsync();
    }

    private void AbrirCarrinho() => _carrinhoAberto = true;
    private void FecharCarrinho() => _carrinhoAberto = false;

    // S3.3: carrega o MaxDiscountPercentage do cargo do usuário logado
    private async Task CarregarLimiteDescontoAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(Auth.Cargo)) return;
            var cargos = await Api.GetAsync<RoleItem[]>("api/Cargos");
            var cargo  = cargos?.FirstOrDefault(c =>
                string.Equals(c.Name, Auth.Cargo, StringComparison.OrdinalIgnoreCase));
            if (cargo != null)
                _maxDesconto = cargo.MaxDiscountPercentage;
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao carregar limite de desconto do cargo, usando fallback — {ex.Message}"); }
    }

    // S3.3: valida desconto ao digitar — bloqueia antes de finalizar
    private void ValidarDesconto(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString()?.Replace(",", "."),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v))
            _desconto = Math.Max(0, v);

        var limiteValor = Subtotal * _maxDesconto / 100;
        _erroDesconto = _desconto > limiteValor && limiteValor > 0
            ? $"Desconto máximo para seu cargo: {_maxDesconto:F0}% ({limiteValor:C})"
            : null;
    }

    private async Task CarregarProdutosAsync(string? search = null)
    {
        _loadingProdutos = true;
        var url = string.IsNullOrEmpty(search)
            ? "api/Products?pageSize=48"
            : $"api/Products?search={Uri.EscapeDataString(search)}&pageSize=48";
        var result       = await Api.GetAsync<PagedResult<ProdutoItem>>(url);
        _produtos        = result?.Items ?? [];
        _loadingProdutos = false;
    }

    private async Task BuscarProdutos(KeyboardEventArgs e)
    {
        if (!(_busca.Length >= 2 || _busca.Length == 0)) return;

        var minhaSequencia = ++_buscaSequencia;
        _loadingProdutos = true;

        // Espera a pessoa parar de digitar (350ms sem tecla nova) antes de
        // buscar de verdade — sem isso, cada letra digitada disparava uma
        // chamada própria, todas competindo ao mesmo tempo.
        await Task.Delay(350);
        if (minhaSequencia != _buscaSequencia) return; // já tem busca mais nova, descarta essa

        var termoNoMomentoDoEnvio = _busca;
        var result = await Api.GetAsync<PagedResult<ProdutoItem>>(
            string.IsNullOrEmpty(termoNoMomentoDoEnvio)
                ? "api/Products?pageSize=48"
                : $"api/Products?search={Uri.EscapeDataString(termoNoMomentoDoEnvio)}&pageSize=48");

        // Se, enquanto a chamada estava no ar, o texto mudou de novo, essa
        // resposta já está desatualizada — descarta, não deixa "piscar"
        // um resultado de uma busca antiga por cima do que está digitado agora.
        if (minhaSequencia != _buscaSequencia) return;

        _produtos        = result?.Items ?? [];
        _loadingProdutos = false;
        StateHasChanged();
    }

    private async Task ToggleMostrarTodos()
    {
        _mostrarTodos = !_mostrarTodos;
        await CarregarProdutosAsync();
    }

    private async Task AdicionarItemAsync(ProdutoItem p)
    {
        var existente = _itens.FirstOrDefault(i => i.ProdutoId == p.Id);
        if (existente != null)
            existente.Quantidade++;
        else
            _itens.Add(new ItemCarrinho
            {
                ProdutoId     = p.Id,
                Nome          = p.Name,
                PrecoUnitario = p.SalePrice,
                Quantidade    = 1
            });

        // S3.5: highlight do card + animação do item + animação do total
        _flashProdutoId = p.Id;
        _ultimoItemId   = p.Id;
        await AnimarTotal();
        StateHasChanged();

        // Remove highlight após 400ms
        await Task.Delay(400);
        _flashProdutoId = null;
        _ultimoItemId   = null;
        StateHasChanged();

        // Revalida desconto
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });

        // Busca produtos agregados
        try
        {
            var ags = await Api.GetAsync<AgregadoItem[]>($"api/Products/{p.Id}/sugestoes");
            if (ags?.Length > 0) { _agregados = ags.ToList(); _agregadoPai = p.Name; }
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao buscar produtos agregados/sugestões — {ex.Message}"); }
    }

    // S3.5: animação verde no total por 600ms
    private async Task AnimarTotal()
    {
        _totalAnimando = true;
        StateHasChanged();
        await Task.Delay(600);
        _totalAnimando = false;
        StateHasChanged();
    }

    private void AdicionarAgregado(AgregadoItem ag)
    {
        var existente = _itens.FirstOrDefault(i => i.ProdutoId == ag.ProdutoRelacionadoId);
        if (existente != null) existente.Quantidade++;
        else _itens.Add(new ItemCarrinho
        {
            ProdutoId     = ag.ProdutoRelacionadoId,
            Nome          = ag.Nome,
            PrecoUnitario = ag.Preco,
            Quantidade    = 1
        });
        FecharAgregados();
        _ = AnimarTotal();
    }

    private void FecharAgregados()  { _agregados = []; _agregadoPai = ""; }
    private void FecharModalFiscal() => _modalFiscal = false;
    private void AbrirModalFiscal()
    {
        // S3.3: bloqueia finalização se desconto inválido
        if (!_itens.Any() || _finalizando || _erroDesconto != null) return;
        _modalFiscal = true;
    }

    private Task ConfirmarNfce()    => ConfirmarVendaAsync("nfce");
    private Task ConfirmarNfe()     => ConfirmarVendaAsync("nfe");
    private Task ConfirmarSemNota() => ConfirmarVendaAsync("sem_nota");

    private void AlterarQtd(ItemCarrinho item, int delta)
    {
        item.Quantidade += delta;
        if (item.Quantidade <= 0)
        {
            _itens.Remove(item);
            if (!_itens.Any()) FecharCarrinho(); // Fecha o carrinho no mobile se esvaziar
        }
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });
        _ = AnimarTotal();
    }

    private void RemoverItem(ItemCarrinho item)
    {
        _itens.Remove(item);
        if (!_itens.Any()) FecharCarrinho(); // Fecha o carrinho no mobile se esvaziar
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });
        _ = AnimarTotal();
    }

    private void LimparCarrinho()
    {
        _itens.Clear();
        _desconto     = 0;
        _clienteId    = null;
        _erroDesconto = null;
        FecharCarrinho(); // Retorna aos produtos no mobile
    }

    private async Task BuscarClienteAsync()
    {
        if (string.IsNullOrWhiteSpace(_nomeCliente)) return;
        var clientes = await Api.GetAsync<ClienteItem[]>(
            $"api/Customers?search={Uri.EscapeDataString(_nomeCliente)}&pageSize=1");
        if (clientes?.Length > 0)
        {
            _nomeCliente = clientes[0].Name;
            _clienteId   = clientes[0].Id;
        }
    }

    private async Task ConfirmarVendaAsync(string tipoNota)
    {
        // S3.3: dupla verificação no submit (defesa em profundidade)
        if (_erroDesconto != null)
        {
            _sucesso  = false;
            _mensagem = $"❌ {_erroDesconto}";
            await Task.Delay(3000);
            _mensagem = null;
            return;
        }

        _modalFiscal = false;
        _finalizando = true;

        var metodoPagamento = _formaPagamento switch
        {
            "Cartão Débito"  => "CartaoDebito",
            "Cartão Crédito" => "CartaoCredito",
            "PIX"            => "Pix",
            "Fiado"          => "APrazo",
            _                => "Dinheiro"
        };

        var payload = new
        {
            CustomerName   = string.IsNullOrWhiteSpace(_nomeCliente) ? (string?)null : _nomeCliente,
            CustomerId     = _clienteId,
            DiscountAmount = _desconto,
            Notes          = tipoNota != "sem_nota" ? $"Nota: {tipoNota.ToUpper()}" : null,
            Payments       = new[] { new { PaymentMethod = metodoPagamento, Amount = Total } },
            Items = _itens.Select(i => new
            {
                ProductId       = i.ProdutoId,
                Quantity        = i.Quantidade,
                UnitPrice       = i.PrecoUnitario,
                TotalItem       = i.Total,
                DiscountPercent = 0m,
                FatorConversao  = 1m
            }).ToList()
        };

        var resp = await Api.PostAsync("api/Sales", payload);
        _finalizando = false;

        if (resp.IsSuccessStatusCode)
        {
            var venda = await resp.Content.ReadFromJsonAsync<VendaCriadaDto>();
            _sucesso  = true;
            _mensagem = $"✅ Venda #{venda?.SaleNumber} registrada! {Total.ToString("C")}";

            if (tipoNota != "sem_nota" && venda?.Id != null)
            {
                var nfResp = await Api.PostAsync(
                    $"api/notas-fiscais/{tipoNota}/emitir-da-venda/{venda.Id}", new { });
                if (!nfResp.IsSuccessStatusCode)
                    _mensagem += " (⚠ Nota não emitida — verifique o módulo Fiscal)";
            }

            LimparCarrinho();
            _nomeCliente = "";
            await Task.Delay(4000);
            _mensagem = null;
        }
        else
        {
            _sucesso  = false;
            var err   = await resp.Content.ReadAsStringAsync();
            var trunc = err.Length > 80 ? err[..80] : err;
            _mensagem = $"❌ Erro: {trunc}";
            await Task.Delay(4000);
            _mensagem = null;
        }
    }

    // ── DTOs locais ───────────────────────────────────────────────────────────
    record ProdutoItem(Guid Id, string Name, string? Sku, string? Barcode,
        string Unit, decimal SalePrice, decimal Stock, string? ImageUrl = null);
    record ClienteItem(Guid Id, string Name);
    record AgregadoItem(Guid Id, Guid ProdutoRelacionadoId, string Nome,
        string? Barcode, string Unit, decimal Preco, decimal Stock, int Ordem);
    record VendaCriadaDto(Guid Id, string SaleNumber);
    record RoleItem(Guid Id, string Name, decimal MaxDiscountPercentage);

    class ItemCarrinho
    {
        public Guid    ProdutoId     { get; set; }
        public string  Nome          { get; set; } = "";
        public decimal PrecoUnitario { get; set; }
        public decimal Quantidade    { get; set; }
        public decimal Total         => PrecoUnitario * Quantidade;
    }
    class PagedResult<T> { public T[] Items { get; set; } = []; }
}