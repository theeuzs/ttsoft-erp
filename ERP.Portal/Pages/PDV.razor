@page "/pdv"
@using ERP.Portal.Services
@inject ApiClient Api
@inject AuthService Auth
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* =========================================================
       PDV
       ========================================================= */

    .pdv-page {
        height: calc(100vh - 54px);
        overflow: hidden;
        background: #F1F5F9;
    }

    .pdv-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 390px;
        height: 100%;
    }

    /* =========================================================
       PRODUTOS
       ========================================================= */

    .pdv-produtos {
        min-width: 0;
        padding: 18px;
        overflow-y: auto;
        background: #F1F5F9;
    }

    .pdv-topbar {
        display: flex;
        gap: 10px;
        margin-bottom: 16px;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .pdv-search {
        flex: 1;
        min-width: 0;
        height: 48px;
        padding: 0 16px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: white;
        font-size: 15px;
        outline: none;
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }

    .pdv-search:focus {
        border-color: #1E62A6;
        box-shadow: 0 0 0 3px rgba(30,98,166,.10);
    }

    .pdv-filter {
        height: 48px;
        padding: 0 15px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: white;
        color: #475569;
        font-weight: 700;
        cursor: pointer;
    }

    .produtos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
        gap: 12px;
    }

    .produto-card {
        background: white;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 14px;
        min-height: 125px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(15,23,42,.05);
        transition:
            transform .12s ease,
            border-color .12s ease,
            box-shadow .12s ease,
            background .12s ease;
        user-select: none;
    }

    .produto-card:hover {
        border-color: #1E62A6;
        background: #F8FBFF;
        box-shadow: 0 5px 16px rgba(15,23,42,.08);
    }

    .produto-card:active {
        transform: scale(.97);
    }

    .produto-card.flash {
        border-color: #10B981 !important;
        background: #ECFDF5 !important;
        transform: scale(.98);
    }

    .produto-codigo {
        font-size: 10px;
        color: #94A3B8;
        margin-bottom: 6px;
        font-family: monospace;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .produto-nome {
        font-size: 13px;
        font-weight: 750;
        line-height: 1.35;
        color: #1E293B;
        min-height: 36px;
    }

    .produto-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
    }

    .produto-preco {
        font-size: 17px;
        font-weight: 850;
        color: #1E62A6;
        white-space: nowrap;
    }

    .produto-estoque {
        font-size: 10px;
        font-weight: 750;
        padding: 4px 7px;
        border-radius: 6px;
        white-space: nowrap;
    }

    /* =========================================================
       CARRINHO DESKTOP
       ========================================================= */

    .pdv-carrinho {
        background: white;
        display: flex;
        flex-direction: column;
        min-width: 0;
        border-left: 1px solid #E2E8F0;
        box-shadow: -5px 0 18px rgba(15,23,42,.04);
        z-index: 20;
    }

    .carrinho-header {
        padding: 17px;
        border-bottom: 1px solid #F1F5F9;
    }

    .carrinho-titulo {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .carrinho-titulo strong {
        font-size: 17px;
        color: #1E293B;
    }

    .limpar-btn {
        border: 0;
        background: transparent;
        color: #EF4444;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .cliente-box {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .cliente-input {
        flex: 1;
        min-width: 0;
        height: 40px;
        padding: 0 11px;
        border: 1px solid #E2E8F0;
        border-radius: 9px;
        font-size: 13px;
        outline: none;
    }

    .cliente-search {
        width: 42px;
        border: 0;
        border-radius: 9px;
        background: #F1F5F9;
        cursor: pointer;
    }

    .carrinho-lista {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }

    .carrinho-vazio {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 30px;
        color: #94A3B8;
        font-size: 13px;
    }

    .carrinho-vazio-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 12px;
    }

    .carrinho-item {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px;
        padding: 13px 16px;
        border-bottom: 1px solid #F1F5F9;
    }

    .item-info {
        min-width: 0;
    }

    .item-nome {
        font-size: 13px;
        font-weight: 700;
        color: #1E293B;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .item-preco {
        margin-top: 3px;
        color: #64748B;
        font-size: 11px;
    }

    .item-total {
        text-align: right;
        font-size: 14px;
        font-weight: 850;
        color: #1E293B;
    }

    .item-controles {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .qtd-btn {
        width: 34px;
        height: 32px;
        border: 1px solid #E2E8F0;
        background: white;
        border-radius: 8px;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
    }

    .qtd-btn:active {
        background: #F1F5F9;
    }

    .qtd {
        min-width: 35px;
        text-align: center;
        font-size: 14px;
        font-weight: 800;
    }

    .remover-btn {
        margin-left: auto;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 8px;
        background: #FEF2F2;
        color: #EF4444;
        cursor: pointer;
    }

    /* =========================================================
       RODAPÉ CARRINHO
       ========================================================= */

    .carrinho-footer {
        border-top: 2px solid #E2E8F0;
        background: #FAFAFA;
        padding: 14px 16px;
    }

    .desconto-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .desconto-row label {
        font-size: 12px;
        font-weight: 700;
        color: #64748B;
    }

    .desconto-input {
        width: 100px;
        height: 34px;
        padding: 0 8px;
        border: 1px solid #E2E8F0;
        border-radius: 7px;
    }

    .subtotal-row,
    .desconto-total-row {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        margin-bottom: 5px;
    }

    .subtotal-row {
        color: #64748B;
    }

    .desconto-total-row {
        color: #EF4444;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 10px 0 14px;
    }

    .total-label {
        font-size: 18px;
        font-weight: 850;
        color: #1E293B;
    }

    .total-valor {
        font-size: 25px;
        font-weight: 900;
        color: #1E293B;
        transition: color .3s ease;
    }

    .total-valor.mudou {
        color: #10B981 !important;
    }

    .pagamentos {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
        margin-bottom: 10px;
    }

    .pagamento-btn {
        min-height: 42px;
        border: 2px solid #E2E8F0;
        border-radius: 9px;
        background: white;
        color: #64748B;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
    }

    .pagamento-btn.ativo {
        border-color: #1E62A6;
        background: #EFF6FF;
        color: #1E62A6;
    }

    .finalizar-btn {
        width: 100%;
        height: 52px;
        border: 0;
        border-radius: 11px;
        color: white;
        font-size: 15px;
        font-weight: 850;
        cursor: pointer;
    }

    /* =========================================================
       BARRA MOBILE
       ========================================================= */

    .mobile-carrinho-bar {
        display: none;
    }

    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 768px) {

        .pdv-page {
            height: calc(100vh - 54px);
        }

        .pdv-grid {
            display: block;
            height: 100%;
        }

        .pdv-produtos {
            height: 100%;
            padding: 10px 10px 85px;
        }

        .pdv-topbar {
            margin-bottom: 10px;
        }

        .pdv-search {
            height: 50px;
            font-size: 16px;
            border-radius: 13px;
        }

        .pdv-filter {
            width: 48px;
            padding: 0;
            font-size: 0;
        }

        .pdv-filter::after {
            content: "☰";
            font-size: 19px;
        }

        .produtos-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
        }

        .produto-card {
            padding: 12px;
            min-height: 122px;
            border-radius: 12px;
        }

        .produto-nome {
            font-size: 12px;
        }

        .produto-bottom {
            flex-wrap: wrap;
            row-gap: 4px;
        }

        .produto-preco {
            font-size: 15px;
        }

        /* Achado (11/09) — estava escondido no celular (display:none), que
           é justamente onde o Matheus mais precisa ver, pra não vender algo
           sem estoque. Reduzido em vez de escondido. */
        .produto-estoque {
            font-size: 9px;
            padding: 3px 5px;
        }

        /* Carrinho vira tela inteira */
        .pdv-carrinho {
            position: fixed;
            inset: 0;
            height: 100dvh;
            width: 100%;
            z-index: 100;
            border: 0;
            transform: translateX(100%);
            transition: transform .22s ease;
        }

        .pdv-carrinho.aberto {
            transform: translateX(0);
        }

        .carrinho-header {
            /* Achado (11/09) — o topbar do app (.topbar, 54px, z-index:200)
               cobria o cabeçalho do carrinho (z-index:100) no celular,
               tampando o botão "← Voltar". Soma a altura do topbar ao
               respiro de notch que já existia. */
            padding-top: calc(54px + max(14px, env(safe-area-inset-top)));
        }

        .carrinho-voltar {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 0;
            background: transparent;
            color: #64748B;
            font-weight: 700;
            margin-bottom: 8px;
            padding: 0;
            font-size: 14px;
            cursor: pointer;
        }

        .carrinho-footer {
            padding-bottom: max(14px, env(safe-area-inset-bottom));
        }

        /* Barra fixa inferior */
        .mobile-carrinho-bar {
            position: fixed;
            display: flex;
            align-items: center;
            gap: 10px;
            left: 10px;
            right: 10px;
            bottom: max(10px, env(safe-area-inset-bottom));
            height: 62px;
            padding: 7px 8px 7px 14px;
            background: #1E293B;
            border-radius: 15px;
            box-shadow: 0 8px 30px rgba(15,23,42,.25);
            z-index: 80;
            color: white;
        }

        .mobile-carrinho-info {
            flex: 1;
            min-width: 0;
        }

        .mobile-carrinho-qtd {
            font-size: 11px;
            color: #CBD5E1;
        }

        .mobile-carrinho-total {
            font-size: 17px;
            font-weight: 850;
        }

        .mobile-carrinho-button {
            height: 48px;
            padding: 0 15px;
            border: 0;
            border-radius: 11px;
            background: #1E62A6;
            color: white;
            font-size: 12px;
            font-weight: 850;
            cursor: pointer;
        }

        .mobile-fechar {
            display: block;
        }
    }

    @@media (min-width: 769px) {
        .carrinho-voltar,
        .mobile-fechar {
            display: none;
        }
    }
</style>

<!-- Beep invisível para erro de barcode (S3.5) -->
<audio id="beep-erro" src="data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAA..." preload="auto" style="display:none"></audio>

<!-- ── Modal: Produtos Agregados ───────────────────────────────────────────── -->
@if (_agregados.Count > 0)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:200;
                display:flex; align-items:center; justify-content:center;"
         @onclick="FecharAgregados">
        <div style="background:white; border-radius:16px; padding:24px; max-width:480px;
                    width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3);"
             @onclick:stopPropagation>
            <div style="font-size:16px; font-weight:800; color:#1E293B; margin-bottom:4px;">
                📦 Produtos frequentemente comprados juntos
            </div>
            <div style="font-size:12px; color:#94A3B8; margin-bottom:16px;">
                Clientes que levaram <strong>@_agregadoPai</strong> também levaram:
            </div>
            @foreach (var ag in _agregados)
            {
                <div style="display:flex; align-items:center; gap:12px; padding:10px 0;
                            border-bottom:1px solid #F1F5F9;">
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:13px; color:#1E293B;">@ag.Nome</div>
                        <div style="font-size:12px; color:#94A3B8;">@ag.Preco.ToString("C") por @ag.Unit</div>
                    </div>
                    <button @onclick="() => AdicionarAgregado(ag)"
                            style="background:#1E62A6; color:white; border:none; padding:8px 14px;
                                   border-radius:8px; font-weight:700; font-size:12px; cursor:pointer;">
                        + Adicionar
                    </button>
                </div>
            }
            <button @onclick="FecharAgregados"
                    style="width:100%; margin-top:16px; background:#F1F5F9; border:none;
                           padding:12px; border-radius:8px; font-weight:600; cursor:pointer;
                           color:#64748B; font-size:13px;">
                Não, obrigado
            </button>
        </div>
    </div>
}

<!-- ── Modal: Opção Fiscal ao Finalizar ───────────────────────────────────── -->
@if (_modalFiscal)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:200;
                display:flex; align-items:center; justify-content:center;">
        <div style="background:white; border-radius:16px; padding:28px; max-width:440px;
                    width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3);">
            <div style="font-size:17px; font-weight:800; color:#1E293B; margin-bottom:6px;">
                🧾 Emitir nota fiscal?
            </div>
            <div style="font-size:13px; color:#94A3B8; margin-bottom:20px;">
                Venda de @Total.ToString("C"). Escolha o tipo de documento ou pule.
            </div>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <button @onclick="ConfirmarNfce"
                        style="padding:14px; background:#1E62A6; color:white; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">📱</span>
                    <div>
                        <div>NFC-e — Nota Fiscal do Consumidor</div>
                        <div style="font-size:11px; opacity:.8;">Para consumidor final · emissão imediata</div>
                    </div>
                </button>
                <button @onclick="ConfirmarNfe"
                        style="padding:14px; background:#7C3AED; color:white; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">📄</span>
                    <div>
                        <div>NF-e — Nota Fiscal Eletrônica</div>
                        <div style="font-size:11px; opacity:.8;">Para CNPJ ou valor alto</div>
                    </div>
                </button>
                <button @onclick="ConfirmarSemNota"
                        style="padding:14px; background:#F1F5F9; color:#64748B; border:none;
                               border-radius:10px; font-weight:700; cursor:pointer; font-size:14px;
                               text-align:left; display:flex; align-items:center; gap:10px;">
                    <span style="font-size:20px;">🧾</span>
                    <div>
                        <div>Sem nota / Recibo simples</div>
                        <div style="font-size:11px; opacity:.8;">Finalizar sem emissão fiscal</div>
                    </div>
                </button>
            </div>
            <button @onclick="FecharModalFiscal"
                    style="width:100%; margin-top:12px; background:transparent; border:none;
                           color:#94A3B8; cursor:pointer; font-size:12px;">
                Cancelar
            </button>
        </div>
    </div>
}

<!-- ── Mensagem Toast (Sucesso/Erro) ──────────────────────────────────────── -->
@if (_mensagem != null)
{
    <div style="position:fixed; top:70px; left:50%; transform:translateX(-50%);
         background:@(_sucesso ? "#27AE60" : "#EF4444"); color:white; padding:14px 28px;
         border-radius:12px; font-size:15px; font-weight:700; z-index:500;
         box-shadow:0 4px 20px rgba(0,0,0,.2);">
        @_mensagem
    </div>
}

<div class="pdv-page">
    <div class="pdv-grid">

        <!-- =====================================================
             PRODUTOS
             ===================================================== -->
        <div class="pdv-produtos">
            <div class="pdv-topbar">
                <input class="pdv-search"
                       @bind="_busca"
                       @bind:event="oninput"
                       @onkeyup="BuscarProdutos"
                       placeholder="🔎 Buscar produto ou código..." />

                <button class="pdv-filter" @onclick="AbrirScanner" title="Ler código de barras pela câmera"
                        style="padding:8px 12px; display:flex; align-items:center; justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 8a2 2 0 0 1 2-2h1.17a2 2 0 0 0 1.6-.8l.5-.67A2 2 0 0 1 10.87 4h2.26a2 2 0 0 1 1.6.8l.5.67a2 2 0 0 0 1.6.8H18a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Z"
                              stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        <circle cx="12" cy="13" r="3.3" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                </button>

                <button class="pdv-filter" @onclick="ToggleMostrarTodos">
                    @(_mostrarTodos ? "Menos" : "📦 Todos")
                </button>
            </div>

            @if (_loadingProdutos)
            {
                <div style="text-align:center;padding:50px;color:#94A3B8;">
                    Carregando produtos...
                </div>
            }
            else
            {
                <div class="produtos-grid">
                    @foreach (var p in _produtos ?? [])
                    {
                        var flashClass = _flashProdutoId == p.Id ? "produto-card flash" : "produto-card";

                        <div class="@flashClass"
                             @onpointerdown="() => IniciarPressao(p)"
                             @onpointerup="() => FinalizarPressao(p)"
                             @onpointerleave="CancelarPressao">
                            @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name"
                                     style="width:100%; height:90px; object-fit:cover; border-radius:8px 8px 0 0; margin-bottom:6px;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div style="width:100%; height:90px; display:flex; align-items:center; justify-content:center;
                                            background:#F1F5F9; border-radius:8px 8px 0 0; margin-bottom:6px; font-size:28px;">
                                    📦
                                </div>
                            }
                            <div class="produto-codigo">
                                @(p.Barcode ?? p.Sku ?? "Sem código")
                            </div>

                            <div class="produto-nome">
                                @(p.Name.Length > 45 ? p.Name[..45] + "…" : p.Name)
                            </div>

                            <div class="produto-bottom">
                                <span class="produto-preco">
                                    @p.SalePrice.ToString("C")
                                </span>

                                <span class="produto-estoque"
                                      style="color:@(p.Stock > 0 ? "#059669" : "#DC2626");
                                             background:@(p.Stock > 0 ? "#D1FAE5" : "#FEE2E2");">
                                    @(p.Stock > 0 ? $"{p.Stock:F0} {p.Unit}" : "Sem estoque")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- =====================================================
             CARRINHO
             ===================================================== -->
        <div class="pdv-carrinho @(_carrinhoAberto ? "aberto" : "")">
            <div class="carrinho-header">
                <button class="carrinho-voltar" @onclick="FecharCarrinho">
                    ← Voltar
                </button>

                <div class="carrinho-titulo">
                    <strong>🛒 Carrinho</strong>
                    @if (_itens.Any())
                    {
                        <button class="limpar-btn" @onclick="LimparCarrinho">
                            Limpar
                        </button>
                    }
                </div>

                <div class="cliente-box" style="position:relative;">
                    <input class="cliente-input"
                           @bind="_nomeCliente"
                           @bind:event="oninput"
                           @onkeyup="BuscarClienteAsync"
                           placeholder="Cliente (opcional)"
                           autocomplete="off"
                           style="@(_clienteId != null ? "padding-right:28px;" : "")" />

                    @if (_clienteId != null)
                    {
                        <button @onclick="LimparClienteSelecionado" title="Remover cliente"
                                style="position:absolute; right:6px; top:50%; transform:translateY(-50%);
                                       background:none; border:none; color:#94A3B8; font-size:16px;
                                       cursor:pointer; padding:2px 6px; line-height:1;">
                            ✕
                        </button>
                    }

                    @if (_clientesBusca.Count > 0)
                    {
                        <div style="position:absolute; top:100%; left:0; right:0; z-index:50;
                                    background:white; border:1px solid #E2E8F0; border-radius:8px;
                                    box-shadow:0 4px 12px rgba(0,0,0,.15); max-height:220px; overflow-y:auto; margin-top:4px;">
                            @foreach (var c in _clientesBusca)
                            {
                                <div @onclick="() => SelecionarCliente(c)"
                                     style="padding:8px 12px; cursor:pointer; font-size:13px; border-bottom:1px solid #F1F5F9;"
                                     onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background='white'">
                                    @c.Name
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- LISTA -->
            <div class="carrinho-lista">
                @if (!_itens.Any())
                {
                    <div class="carrinho-vazio">
                        <div class="carrinho-vazio-icon">🛒</div>
                        <strong>Carrinho vazio</strong>
                        <span style="margin-top:5px;">Toque em um produto para adicionar</span>
                    </div>
                }
                else
                {
                    @foreach (var item in _itens)
                    {
                        var isNovo = _ultimoItemId == item.ProdutoId;

                        <div class="carrinho-item @(isNovo ? "novo" : "")">
                            <div class="item-info">
                                <div class="item-nome">@item.Nome</div>
                                <div class="item-preco">
                                    @item.PrecoUnitario.ToString("C") × @item.Quantidade
                                </div>
                            </div>
                            <div class="item-total">
                                @item.Total.ToString("C")
                            </div>

                            <div class="item-controles">
                                <button class="qtd-btn" @onclick="() => AlterarQtd(item, -1)">−</button>
                                <span class="qtd">@item.Quantidade</span>
                                <button class="qtd-btn" @onclick="() => AlterarQtd(item, 1)">+</button>
                                <button class="remover-btn" @onclick="() => RemoverItem(item)">✕</button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- =================================================
                 FOOTER DO CARRINHO
                 ================================================= -->
            <div class="carrinho-footer">
                @if (_itens.Any())
                {
                    <div class="desconto-row">
                        <label>Desconto</label>
                        <input class="desconto-input"
                               type="number"
                               value="@_desconto.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="ValidarDesconto"
                               min="0"
                               step="0.50" />
                        <span>R$</span>
                    </div>

                    @if (_erroDesconto != null)
                    {
                        <div style="font-size:11px; color:#DC2626; font-weight:700; background:#FEF2F2;
                                    padding:7px 9px; border-radius:7px; margin-bottom:8px;">
                            🚫 @_erroDesconto
                        </div>
                    }
                    @if (_maxDesconto > 0 && _erroDesconto == null)
                    {
                        <div style="font-size:11px; color:#94A3B8; margin-bottom:8px;">
                            Limite: @_maxDesconto.ToString("F0")% (@LimiteDescontoValor.ToString("C"))
                        </div>
                    }

                    <div class="subtotal-row">
                        <span>Subtotal</span>
                        <span>@Subtotal.ToString("C")</span>
                    </div>

                    @if (_desconto > 0)
                    {
                        <div class="desconto-total-row">
                            <span>Desconto</span>
                            <span>-@_desconto.ToString("C")</span>
                        </div>
                    }

                    <div class="total-row">
                        <span class="total-label">TOTAL</span>
                        <span class="total-valor @(_totalAnimando ? "mudou" : "")">
                            @Total.ToString("C")
                        </span>
                    </div>

                    <!-- PAGAMENTOS -->
                    @if (_pagamentos.Count > 0)
                    {
                        <div style="margin-bottom:8px;">
                            @foreach (var p in _pagamentos)
                            {
                                <div style="display:flex; justify-content:space-between; align-items:center;
                                            font-size:12px; padding:4px 0;">
                                    <span>@p.Forma: <strong>@p.Valor.ToString("C")</strong></span>
                                    <button @onclick="() => RemoverPagamento(p)"
                                            style="background:none; border:none; color:#DC2626; cursor:pointer;">✕</button>
                                </div>
                            }
                            @if (_trocoTotal > 0)
                            {
                                <div style="font-size:12px; color:#059669; font-weight:700;">
                                    Troco a devolver: @_trocoTotal.ToString("C")
                                </div>
                            }
                        </div>
                    }

                    @if (FaltaPagar > 0.005m)
                    {
                        <div style="font-size:13px; font-weight:700; color:#DC2626; margin-bottom:6px;">
                            Falta: @FaltaPagar.ToString("C")
                        </div>

                        <div class="pagamentos">
                            @foreach (var (forma, icone) in new[] {
                                ("Dinheiro","💵"), ("Cartão Débito","💳"),
                                ("Cartão Crédito","💳"), ("PIX","📲"), ("A PRAZO","📋")
                            })
                            {
                                <button class="pagamento-btn @(_formaAbrindo == forma ? "ativo" : "")"
                                        @onclick="() => AbrirFormaPagamento(forma)">
                                    @icone @forma
                                </button>
                            }
                        </div>

                        @if (_formaAbrindo != null)
                        {
                            <div style="background:#F8FAFC; border-radius:8px; padding:10px; margin-top:8px;">
                                <div style="font-size:11px; color:#64748B; margin-bottom:4px;">
                                    @(_formaAbrindo == "Dinheiro" ? "Valor recebido do cliente" : $"Valor em {_formaAbrindo}")
                                </div>
                                <div style="display:flex; gap:8px;">
                                    <input type="number" min="0" step="0.50"
                                           value="@_valorDigitado.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           @oninput="OnValorPagamentoInput"
                                           style="flex:1; padding:8px; border:1px solid #E2E8F0; border-radius:6px;" />
                                    <button @onclick="ConfirmarPagamentoLinha"
                                            style="background:#1E62A6; color:white; border:none; border-radius:6px; padding:8px 16px; font-weight:700; cursor:pointer;">
                                        Adicionar
                                    </button>
                                </div>
                                @if (_formaAbrindo == "Dinheiro" && TrocoPreview > 0)
                                {
                                    <div style="font-size:13px; color:#059669; font-weight:700; margin-top:6px;">
                                        Troco: @TrocoPreview.ToString("C")
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_pagamentos.Count > 0)
                    {
                        <div style="font-size:13px; color:#059669; font-weight:700; text-align:center; margin-bottom:8px;">
                            ✓ Pagamento completo
                        </div>
                    }

                    @if (_clienteId != null)
                    {
                        <label style="display:flex; align-items:center; gap:6px; font-size:12px; color:#475569; margin:8px 0; cursor:pointer;">
                            <input type="checkbox" @bind="_entregarNoEndereco" />
                            🚚 Entregar no endereço do cliente (sai na nota)
                        </label>
                    }

                    <button class="finalizar-btn"
                            @onclick="AbrirModalFiscal"
                            disabled="@(_finalizando || _erroDesconto != null || FaltaPagar > 0.005m)"
                            style="background:@(_erroDesconto != null || FaltaPagar > 0.005m ? "#94A3B8" : "#16A34A");">
                        @(_finalizando ? "⏳ Finalizando..." : $"✓ Finalizar Venda · {Total.ToString("C")}")
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- =========================================================
         BARRA MOBILE INFERIOR (Aciona o Carrinho)
         ========================================================= -->
    @if (_itens.Any())
    {
        <div class="mobile-carrinho-bar">
            <div class="mobile-carrinho-info">
                <div class="mobile-carrinho-qtd">
                    @QuantidadeItens @(QuantidadeItens == 1 ? "item" : "itens")
                </div>
                <div class="mobile-carrinho-total">
                    @Total.ToString("C")
                </div>
            </div>
            <button class="mobile-carrinho-button" @onclick="AbrirCarrinho">
                VER CARRINHO →
            </button>
        </div>
    }
</div>

