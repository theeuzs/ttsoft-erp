<script src="lib/zxing.min.js"></script>
<script src="js/barcode-scanner.js"></script>
<script src="js/pdv-storage.js"></script>

@code {
    // ── Leitor de código de barras via câmera ───────────────────────────────
    private bool                             _scannerAberto;
    private string?                          _erroScanner;
    private DotNetObjectReference<PDV>?      _scannerRef;

    private async Task AbrirScanner()
    {
        _erroScanner    = null;
        _scannerAberto  = true;
        StateHasChanged();

        // Espera o <video> existir no DOM antes de pedir a câmera pra ele.
        await Task.Delay(50);

        _scannerRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("iniciarScannerCodigoBarras", "video-scanner", _scannerRef);
    }

    private async Task FecharScanner()
    {
        await JS.InvokeVoidAsync("pararScannerCodigoBarras");
        _scannerRef?.Dispose();
        _scannerRef    = null;
        _scannerAberto = false;
        _erroScanner   = null;
    }

    [JSInvokable]
    public async Task OnCodigoLido(string codigo)
    {
        await FecharScanner();
        _busca = codigo;
        await CarregarProdutosAsync(codigo);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnErroScanner(string mensagem)
    {
        _erroScanner = mensagem.Contains("Permission", StringComparison.OrdinalIgnoreCase)
            ? "Permissão de câmera negada. Habilite o acesso à câmera nas configurações do navegador."
            : $"Não foi possível acessar a câmera: {mensagem}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_scannerAberto)
        {
            try { await JS.InvokeVoidAsync("pararScannerCodigoBarras"); }
            catch (Exception ex) { Console.WriteLine($"PDV: falha ao parar scanner no dispose — {ex.Message}"); }
        }
        _scannerRef?.Dispose();
    }

    private ProdutoItem[]?     _produtos;
    private string             _busca            = "";
    // Achado (10/09) — busca disparava a cada tecla, sem debounce, e sem
    // checar se a resposta ainda correspondia ao texto atual. Respostas
    // fora de ordem faziam a lista "mudar sozinha" enquanto digitava.
    private int                _buscaSequencia   = 0;
    private bool               _mostrarTodos     = false;
    private bool               _loadingProdutos  = true;
    private List<ItemCarrinho> _itens            = new();
    private string             _nomeCliente      = "";
    private Guid?              _clienteId;
    private decimal            _desconto         = 0;
    // Achado (11/09) — Portal só aceitava UMA forma de pagamento por venda;
    // WPF já suporta dividir (dinheiro + cartão, etc.) e calcular troco.
    // Trazido pro mesmo padrão: Payments[i].Amount de Dinheiro carrega o
    // valor BRUTO recebido (não o líquido já descontado o troco) — é assim
    // que o Sync Engine sabe quanto lançar de verdade no Caixa depois
    // (mesmo comentário existente no CreateSaleDto, do lado da API).
    private class PagamentoLinha
    {
        public string  Forma { get; set; } = "";
        public decimal Valor { get; set; } // bruto — pra Dinheiro, inclui o que vira troco
    }

    private List<PagamentoLinha> _pagamentos      = [];
    private string?              _formaAbrindo;    // qual botão está com o campo de valor aberto
    private decimal              _valorDigitado    = 0;
    private decimal              _trocoTotal       = 0;

    private decimal TotalPago    => _pagamentos.Sum(p => p.Valor) - _trocoTotal;
    private decimal FaltaPagar   => Math.Max(0, Total - TotalPago);
    private decimal TrocoPreview => _formaAbrindo == "Dinheiro" ? Math.Max(0, _valorDigitado - FaltaPagar) : 0;

    private bool                 _entregarNoEndereco;
    private ClienteItem?         _clienteCompleto; // guarda endereço pra montar a nota, quando marcado
    private bool               _finalizando      = false;
    private string?            _mensagem;
    private bool               _sucesso          = true;
    private bool               _modalFiscal      = false;

    // S3.3: limite de desconto por cargo
    private decimal _maxDesconto  = 100; // % — padrão antes de carregar o cargo
    private string? _erroDesconto;

    // S3.5: feedback visual
    private Guid?  _flashProdutoId;
    private Guid?  _ultimoItemId;
    private bool   _totalAnimando = false;

    // Produtos Agregados
    private List<AgregadoItem> _agregados   = [];
    private string             _agregadoPai = "";

    // Mobile UX
    private bool _carrinhoAberto = false;

    private decimal Subtotal => _itens.Sum(i => i.Total);
    private decimal Total    => Math.Max(0, Subtotal - _desconto);
    private decimal LimiteDescontoValor => Subtotal * _maxDesconto / 100;
    private int QuantidadeItens => (int)_itens.Sum(i => i.Quantidade);

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutosAsync();
        await CarregarLimiteDescontoAsync();
        await RestaurarCarrinhoAsync();
    }

    // Achado (11/09) — o carrinho inteiro se perdia ao navegar pra outra
    // página (Produtos, Vendas) e voltar pro PDV, já que o componente
    // Blazor recomeça do zero. Salva/restaura via sessionStorage — sobrevive
    // à navegação, mas some sozinho se a aba fechar (não é persistência
    // permanente, é só "não perder a venda no meio").
    private class CarrinhoSnapshot
    {
        public List<ItemCarrinho>    Itens               { get; set; } = [];
        public Guid?                 ClienteId           { get; set; }
        public string                NomeCliente         { get; set; } = "";
        public List<PagamentoLinha>  Pagamentos          { get; set; } = [];
        public decimal               TrocoTotal          { get; set; }
        public bool                  EntregarNoEndereco  { get; set; }
        public decimal               Desconto            { get; set; }
    }

    private async Task SalvarCarrinhoAsync()
    {
        try
        {
            var snap = new CarrinhoSnapshot
            {
                Itens              = _itens,
                ClienteId          = _clienteId,
                NomeCliente        = _nomeCliente,
                Pagamentos         = _pagamentos,
                TrocoTotal         = _trocoTotal,
                EntregarNoEndereco = _entregarNoEndereco,
                Desconto           = _desconto
            };
            await JS.InvokeVoidAsync("salvarCarrinhoPdv", System.Text.Json.JsonSerializer.Serialize(snap));
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao salvar carrinho — {ex.Message}"); }
    }

    private async Task RestaurarCarrinhoAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("carregarCarrinhoPdv");
            if (string.IsNullOrWhiteSpace(json)) return;

            var snap = System.Text.Json.JsonSerializer.Deserialize<CarrinhoSnapshot>(json);
            if (snap == null || snap.Itens.Count == 0) return;

            _itens               = snap.Itens;
            _clienteId           = snap.ClienteId;
            _nomeCliente         = snap.NomeCliente;
            _pagamentos          = snap.Pagamentos;
            _trocoTotal          = snap.TrocoTotal;
            _entregarNoEndereco  = snap.EntregarNoEndereco;
            _desconto            = snap.Desconto;
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao restaurar carrinho — {ex.Message}"); }
    }

    private async Task LimparCarrinhoStorageAsync()
    {
        try { await JS.InvokeVoidAsync("limparCarrinhoPdvStorage"); }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao limpar carrinho salvo — {ex.Message}"); }
    }

    private void AbrirCarrinho() => _carrinhoAberto = true;
    private void FecharCarrinho() => _carrinhoAberto = false;

    // S3.3: carrega o MaxDiscountPercentage do cargo do usuário logado
    private async Task CarregarLimiteDescontoAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(Auth.Cargo)) return;
            var cargos = await Api.GetAsync<RoleItem[]>("api/Cargos");
            var cargo  = cargos?.FirstOrDefault(c =>
                string.Equals(c.Name, Auth.Cargo, StringComparison.OrdinalIgnoreCase));
            if (cargo != null)
                _maxDesconto = cargo.MaxDiscountPercentage;
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao carregar limite de desconto do cargo, usando fallback — {ex.Message}"); }
    }

    // S3.3: valida desconto ao digitar — bloqueia antes de finalizar
    // Achado (11/09) — controle do pagamento dividido + troco ao vivo.
    private void AbrirFormaPagamento(string forma)
    {
        _formaAbrindo  = forma;
        _valorDigitado = FaltaPagar; // já sugere o valor que falta, ajustável
    }

    private void OnValorPagamentoInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString()?.Replace(",", "."),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v))
            _valorDigitado = Math.Max(0, v);
    }

    private async Task ConfirmarPagamentoLinha()
    {
        if (_formaAbrindo == null || _valorDigitado <= 0) return;

        _pagamentos.Add(new PagamentoLinha { Forma = _formaAbrindo, Valor = _valorDigitado });
        RecalcularTroco();
        _formaAbrindo  = null;
        _valorDigitado = 0;
        await SalvarCarrinhoAsync();
    }

    private async Task RemoverPagamento(PagamentoLinha p)
    {
        _pagamentos.Remove(p);
        RecalcularTroco();
        await SalvarCarrinhoAsync();
    }

    // Achado (11/09) — refaz a conta do zero simulando a ordem de entrada de
    // cada linha, em vez de tentar ajustar incrementalmente. Mais simples de
    // acompanhar e sempre correto, mesmo removendo uma linha do meio da lista.
    // Payments[i].Amount de Dinheiro carrega o valor BRUTO recebido (mesmo
    // padrão do WPF/API) — o troco é rastreado à parte (_trocoTotal).
    private void RecalcularTroco()
    {
        _trocoTotal = 0;
        var restante = Total;
        foreach (var linha in _pagamentos)
        {
            if (linha.Forma == "Dinheiro")
            {
                var trocoDestaLinha = Math.Max(0, linha.Valor - Math.Max(0, restante));
                _trocoTotal += trocoDestaLinha;
                restante -= (linha.Valor - trocoDestaLinha);
            }
            else
            {
                restante -= linha.Valor;
            }
        }
    }

    private void ValidarDesconto(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString()?.Replace(",", "."),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v))
            _desconto = Math.Max(0, v);

        var limiteValor = Subtotal * _maxDesconto / 100;
        _erroDesconto = _desconto > limiteValor && limiteValor > 0
            ? $"Desconto máximo para seu cargo: {_maxDesconto:F0}% ({limiteValor:C})"
            : null;
    }

    private async Task CarregarProdutosAsync(string? search = null)
    {
        _loadingProdutos = true;
        var url = string.IsNullOrEmpty(search)
            ? "api/Products?pageSize=48"
            : $"api/Products?search={Uri.EscapeDataString(search)}&pageSize=48";
        var result       = await Api.GetAsync<PagedResult<ProdutoItem>>(url);
        _produtos        = result?.Items ?? [];
        _loadingProdutos = false;
    }

    private async Task BuscarProdutos(KeyboardEventArgs e)
    {
        if (!(_busca.Length >= 2 || _busca.Length == 0)) return;

        var minhaSequencia = ++_buscaSequencia;
        _loadingProdutos = true;

        // Espera a pessoa parar de digitar (350ms sem tecla nova) antes de
        // buscar de verdade — sem isso, cada letra digitada disparava uma
        // chamada própria, todas competindo ao mesmo tempo.
        await Task.Delay(350);
        if (minhaSequencia != _buscaSequencia) return; // já tem busca mais nova, descarta essa

        var termoNoMomentoDoEnvio = _busca;
        var result = await Api.GetAsync<PagedResult<ProdutoItem>>(
            string.IsNullOrEmpty(termoNoMomentoDoEnvio)
                ? "api/Products?pageSize=48"
                : $"api/Products?search={Uri.EscapeDataString(termoNoMomentoDoEnvio)}&pageSize=48");

        // Se, enquanto a chamada estava no ar, o texto mudou de novo, essa
        // resposta já está desatualizada — descarta, não deixa "piscar"
        // um resultado de uma busca antiga por cima do que está digitado agora.
        if (minhaSequencia != _buscaSequencia) return;

        _produtos        = result?.Items ?? [];
        _loadingProdutos = false;
        StateHasChanged();
    }

    private async Task ToggleMostrarTodos()
    {
        _mostrarTodos = !_mostrarTodos;
        await CarregarProdutosAsync();
    }

    private async Task AdicionarItemAsync(ProdutoItem p, decimal quantidade = 1)
    {
        var existente = _itens.FirstOrDefault(i => i.ProdutoId == p.Id);
        if (existente != null)
            existente.Quantidade += quantidade;
        else
            _itens.Add(new ItemCarrinho
            {
                ProdutoId     = p.Id,
                Nome          = p.Name,
                PrecoUnitario = p.SalePrice,
                Quantidade    = quantidade
            });

        // S3.5: highlight do card + animação do item + animação do total
        _flashProdutoId = p.Id;
        _ultimoItemId   = p.Id;
        await AnimarTotal();
        await SalvarCarrinhoAsync();
        StateHasChanged();

        // Remove highlight após 400ms
        await Task.Delay(400);
        _flashProdutoId = null;
        _ultimoItemId   = null;
        StateHasChanged();

        // Revalida desconto
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });

        // Busca produtos agregados
        try
        {
            var ags = await Api.GetAsync<AgregadoItem[]>($"api/Products/{p.Id}/sugestoes");
            if (ags?.Length > 0) { _agregados = ags.ToList(); _agregadoPai = p.Name; }
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao buscar produtos agregados/sugestões — {ex.Message}"); }
    }

    // Achado (11/09) — clique rápido adiciona 1 direto (fluxo rápido de
    // quem já sabe o que quer / bipagem); segurar ~500ms abre popup pra
    // digitar a quantidade. Um só CancellationTokenSource compartilhado
    // basta, porque só é fisicamente possível pressionar um card por vez.
    private CancellationTokenSource? _pressaoCts;
    private bool                     _pressaoLongaDisparada;

    private void IniciarPressao(ProdutoItem p)
    {
        _pressaoLongaDisparada = false;
        _pressaoCts?.Cancel();
        var cts = _pressaoCts = new CancellationTokenSource();
        _ = DispararPressaoLongaAsync(p, cts.Token);
    }

    private async Task DispararPressaoLongaAsync(ProdutoItem p, CancellationToken ct)
    {
        try
        {
            await Task.Delay(500, ct);
            _pressaoLongaDisparada = true;
            AbrirPopupQuantidade(p);
        }
        catch (TaskCanceledException) { /* soltou antes de 500ms — vira clique normal */ }
    }

    private async Task FinalizarPressao(ProdutoItem p)
    {
        _pressaoCts?.Cancel();
        if (!_pressaoLongaDisparada)
            await AdicionarItemAsync(p);
    }

    private void CancelarPressao() => _pressaoCts?.Cancel();

    private ProdutoItem? _popupQtdProduto;
    private decimal      _popupQtdValor = 1;

    private void AbrirPopupQuantidade(ProdutoItem p)
    {
        _popupQtdProduto = p;
        _popupQtdValor   = 1;
        StateHasChanged();
    }

    private async Task ConfirmarPopupQuantidadeAsync()
    {
        if (_popupQtdProduto != null && _popupQtdValor > 0)
            await AdicionarItemAsync(_popupQtdProduto, _popupQtdValor);
        _popupQtdProduto = null;
    }

    private void CancelarPopupQuantidade() => _popupQtdProduto = null;

    // S3.5: animação verde no total por 600ms
    private async Task AnimarTotal()
    {
        _totalAnimando = true;
        StateHasChanged();
        await Task.Delay(600);
        _totalAnimando = false;
        StateHasChanged();
    }

    private void AdicionarAgregado(AgregadoItem ag)
    {
        var existente = _itens.FirstOrDefault(i => i.ProdutoId == ag.ProdutoRelacionadoId);
        if (existente != null) existente.Quantidade++;
        else _itens.Add(new ItemCarrinho
        {
            ProdutoId     = ag.ProdutoRelacionadoId,
            Nome          = ag.Nome,
            PrecoUnitario = ag.Preco,
            Quantidade    = 1
        });
        FecharAgregados();
        _ = AnimarTotal();
    }

    private void FecharAgregados()  { _agregados = []; _agregadoPai = ""; }
    private void FecharModalFiscal() => _modalFiscal = false;
    private void AbrirModalFiscal()
    {
        // S3.3: bloqueia finalização se desconto inválido
        if (!_itens.Any() || _finalizando || _erroDesconto != null) return;
        _modalFiscal = true;
    }

    private Task ConfirmarNfce()    => ConfirmarVendaAsync("nfce");
    private Task ConfirmarNfe()     => ConfirmarVendaAsync("nfe");
    private Task ConfirmarSemNota() => ConfirmarVendaAsync("sem_nota");

    private async Task AlterarQtd(ItemCarrinho item, int delta)
    {
        item.Quantidade += delta;
        if (item.Quantidade <= 0)
        {
            _itens.Remove(item);
            if (!_itens.Any()) FecharCarrinho(); // Fecha o carrinho no mobile se esvaziar
        }
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });
        await SalvarCarrinhoAsync();
        _ = AnimarTotal();
    }

    private async Task RemoverItem(ItemCarrinho item)
    {
        _itens.Remove(item);
        if (!_itens.Any()) FecharCarrinho(); // Fecha o carrinho no mobile se esvaziar
        ValidarDesconto(new ChangeEventArgs { Value = _desconto.ToString() });
        await SalvarCarrinhoAsync();
        _ = AnimarTotal();
    }

    private async Task LimparCarrinho()
    {
        _itens.Clear();
        _desconto            = 0;
        _clienteId           = null;
        _nomeCliente         = "";
        _erroDesconto        = null;
        _pagamentos.Clear();
        _trocoTotal          = 0;
        _formaAbrindo        = null;
        _valorDigitado       = 0;
        _entregarNoEndereco  = false;
        _clienteCompleto     = null;
        await LimparCarrinhoStorageAsync();
        FecharCarrinho(); // Retorna aos produtos no mobile
    }

    // Achado (11/09) — campo usava @bind sem "oninput", só atualizava ao
    // perder foco; e a busca antiga só rodava com clique explícito, sem
    // debounce, sem lista — auto-selecionava o primeiro resultado sem
    // deixar escolher. Reescrito no mesmo padrão da busca de produto.
    private List<ClienteItem> _clientesBusca      = [];
    private int               _buscaClienteSeq    = 0;

    private async Task BuscarClienteAsync(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_nomeCliente) || _nomeCliente.Length < 2)
        {
            _clientesBusca = [];
            return;
        }

        var minhaSeq = ++_buscaClienteSeq;
        await Task.Delay(350);
        if (minhaSeq != _buscaClienteSeq) return;

        try
        {
            // Achado (11/09) — a API devolve PagedResult<CustomerDto> (um
            // objeto com .Items dentro), não um array direto. Lendo como
            // array puro, a desserialização sempre falhava silenciosamente
            // — por isso NENHUMA busca de cliente jamais funcionou, desde
            // sempre (bug herdado do código original, não só da minha
            // correção anterior).
            var resultado = await Api.GetAsync<PagedResult<ClienteItem>>(
                $"api/Customers?search={Uri.EscapeDataString(_nomeCliente)}&pageSize=8");
            if (minhaSeq != _buscaClienteSeq) return; // resposta atrasada, descarta

            _clientesBusca = resultado?.Items?.ToList() ?? [];
            StateHasChanged();
        }
        catch (Exception ex) { Console.WriteLine($"PDV: falha ao buscar cliente — {ex.Message}"); }
    }

    private void SelecionarCliente(ClienteItem c)
    {
        _nomeCliente     = c.Name;
        _clienteId       = c.Id;
        _clienteCompleto = c;
        _clientesBusca   = [];
    }

    private void LimparClienteSelecionado()
    {
        _nomeCliente        = "";
        _clienteId          = null;
        _clienteCompleto    = null;
        _entregarNoEndereco = false;
        _clientesBusca      = [];
    }

    private async Task ConfirmarVendaAsync(string tipoNota)
    {
        // S3.3: dupla verificação no submit (defesa em profundidade)
        if (_erroDesconto != null)
        {
            _sucesso  = false;
            _mensagem = $"❌ {_erroDesconto}";
            await Task.Delay(3000);
            _mensagem = null;
            return;
        }

        // Achado (11/09) — A Prazo sem cliente selecionado conseguia
        // finalizar (dinheiro sem dono virando venda a prazo sem ninguém
        // pra cobrar). No WPF isso já é bloqueado; o Portal nunca teve essa
        // mesma trava. Agora checa a LISTA de pagamentos, já que a venda
        // pode ter mais de uma forma.
        if (_pagamentos.Any(p => p.Forma == "A PRAZO") && _clienteId == null)
        {
            _modalFiscal = false;
            _sucesso  = false;
            _mensagem = "❌ Venda a prazo precisa de um cliente selecionado.";
            await Task.Delay(3000);
            _mensagem = null;
            return;
        }

        _modalFiscal = false;
        _finalizando = true;

        string MapearForma(string forma) => forma switch
        {
            "Cartão Débito"  => "CartaoDebito",
            "Cartão Crédito" => "CartaoCredito",
            "PIX"            => "Pix",
            "A PRAZO"        => "APrazo",
            _                => "Dinheiro"
        };

        // Achado (11/09) — monta o endereço de entrega igual o WPF faz
        // (EnderecoEntrega), colado nas observações da venda, já que não
        // existe campo próprio de endereço de entrega na venda em si.
        var partesNota = new List<string>();
        if (tipoNota != "sem_nota") partesNota.Add($"Nota: {tipoNota.ToUpper()}");
        if (_entregarNoEndereco && _clienteCompleto != null)
        {
            var endereco = $"{_clienteCompleto.Street}, {_clienteCompleto.Number} - {_clienteCompleto.Neighborhood}, {_clienteCompleto.City}/{_clienteCompleto.State}";
            partesNota.Add($"ENTREGA: {endereco}");
        }

        var payload = new
        {
            CustomerName   = string.IsNullOrWhiteSpace(_nomeCliente) ? (string?)null : _nomeCliente,
            CustomerId     = _clienteId,
            DiscountAmount = _desconto,
            Notes          = partesNota.Count > 0 ? string.Join(" | ", partesNota) : null,
            Troco          = _trocoTotal,
            Payments       = _pagamentos.Select(p => new { PaymentMethod = MapearForma(p.Forma), Amount = p.Valor }).ToList(),
            Items = _itens.Select(i => new
            {
                ProductId       = i.ProdutoId,
                Quantity        = i.Quantidade,
                UnitPrice       = i.PrecoUnitario,
                TotalItem       = i.Total,
                DiscountPercent = 0m,
                FatorConversao  = 1m
            }).ToList()
        };

        var resp = await Api.PostAsync("api/Sales", payload);
        _finalizando = false;

        if (resp.IsSuccessStatusCode)
        {
            var venda = await resp.Content.ReadFromJsonAsync<VendaCriadaDto>();
            _sucesso  = true;
            _mensagem = $"✅ Venda #{venda?.SaleNumber} registrada! {Total.ToString("C")}";

            if (tipoNota != "sem_nota" && venda?.Id != null)
            {
                var nfResp = await Api.PostAsync(
                    $"api/notas-fiscais/{tipoNota}/emitir-da-venda/{venda.Id}", new { });
                if (!nfResp.IsSuccessStatusCode)
                    _mensagem += " (⚠ Nota não emitida — verifique o módulo Fiscal)";
            }

            await LimparCarrinho();
            _nomeCliente = "";
            await Task.Delay(4000);
            _mensagem = null;
        }
        else
        {
            _sucesso  = false;
            var err   = await resp.Content.ReadAsStringAsync();
            var trunc = err.Length > 80 ? err[..80] : err;
            _mensagem = $"❌ Erro: {trunc}";
            await Task.Delay(4000);
            _mensagem = null;
        }
    }

    // ── DTOs locais ───────────────────────────────────────────────────────────
    record ProdutoItem(Guid Id, string Name, string? Sku, string? Barcode,
        string Unit, decimal SalePrice, decimal Stock, string? ImageUrl = null);
    record ClienteItem(Guid Id, string Name, string? Street = null, string? Number = null,
        string? Neighborhood = null, string? City = null, string? State = null);
    record AgregadoItem(Guid Id, Guid ProdutoRelacionadoId, string Nome,
        string? Barcode, string Unit, decimal Preco, decimal Stock, int Ordem);
    record VendaCriadaDto(Guid Id, string SaleNumber);
    record RoleItem(Guid Id, string Name, decimal MaxDiscountPercentage);

    class ItemCarrinho
    {
        public Guid    ProdutoId     { get; set; }
        public string  Nome          { get; set; } = "";
        public decimal PrecoUnitario { get; set; }
        public decimal Quantidade    { get; set; }
        public decimal Total         => PrecoUnitario * Quantidade;
    }
    class PagedResult<T> { public T[] Items { get; set; } = []; }
}