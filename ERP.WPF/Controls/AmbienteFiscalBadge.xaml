<UserControl x:Class="ERP.WPF.Controls.AmbienteFiscalBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Item 3.1 do plano premium — "o desastre clássico do lojista é emitir
         o mês inteiro em homologação sem perceber". Badge impossível de
         ignorar, reutilizável em toda tela fiscal. -->
    <Border CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EhProducao, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="#DCFCE7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock FontWeight="Black" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="🟡 AMBIENTE: HOMOLOGAÇÃO — notas aqui não valem nada pra SEFAZ"/>
                    <Setter Property="Foreground" Value="#92400E"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EhProducao, ElementName=Root}" Value="True">
                            <Setter Property="Text" Value="🟢 AMBIENTE: PRODUÇÃO — notas aqui são reais e valem na SEFAZ"/>
                            <Setter Property="Foreground" Value="#166534"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
