<UserControl x:Class="ERP.WPF.Controls.ModuloHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="15,0,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding Icone, ElementName=Root}"
                   FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>

        <TextBlock Grid.Column="1" Text="{Binding Titulo, ElementName=Root}"
                   FontSize="14" Foreground="#DDDDDD" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <Border Grid.Column="2" Background="#EF4444" CornerRadius="9" Padding="7,2"
                Visibility="{Binding Badge, ElementName=Root, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Badge, ElementName=Root}" FontSize="10" FontWeight="Bold" Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
