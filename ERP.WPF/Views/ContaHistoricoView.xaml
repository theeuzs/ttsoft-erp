<Window x:Class="ERP.WPF.Views.ContaHistoricoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico da Conta" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9" FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontSize="20" FontWeight="Black"
                   Foreground="#0F172A" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Eventos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                        VerticalAlignment="Top" Margin="0,4,14,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#94A3B8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Criada">
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Pagamento">
                                                    <Setter Property="Background" Value="#16A34A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Desconto">
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Cancelamento">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold" FontSize="14" Foreground="#0F172A">
                                        <Run Text="{Binding Tipo, Mode=OneWay}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding DataEvento, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="#334155" Margin="0,4,0,0"
                                               Visibility="{Binding Valor, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="Valor: "/>
                                        <Run Text="{Binding Valor, Mode=OneWay, StringFormat='R$ {0:N2}'}" FontWeight="SemiBold"/>
                                    </TextBlock>

                                    <TextBlock Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Observacao, Converter={StaticResource NullToCollapsed}}"
                                               Text="{Binding Observacao, Mode=OneWay}"/>

                                    <TextBlock Foreground="#94A3B8" FontSize="12" Margin="0,6,0,0"
                                               Visibility="{Binding UsuarioNome, Converter={StaticResource NullToCollapsed}}">
                                        <Run Text="por "/>
                                        <Run Text="{Binding UsuarioNome, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
