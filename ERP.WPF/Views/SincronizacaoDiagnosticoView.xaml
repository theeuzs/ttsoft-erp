<UserControl x:Class="ERP.WPF.Views.SincronizacaoDiagnosticoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBgAlt}">

    <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="🔄 Sincronização Offline (Diagnóstico)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
        <TextBlock FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,4">
            Tela temporária pra validar a Fase 2 do Offline-First manualmente. O Sync Engine automático em
            background e o indicador 🟢/🔴 são da Fase 3, ainda não construídos — enquanto isso não existe,
            use os botões abaixo pra disparar a sincronização na mão depois de testar uma venda offline.
        </TextBlock>

        <Border Background="#FEF3C7" CornerRadius="6" Padding="10" Margin="0,8,0,16">
            <TextBlock Text="⚠️ Essa tela é descartável — remover quando a Fase 3 (sincronização automática) estiver pronta." FontSize="11" Foreground="#92400E"/>
        </Border>

        <Border Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Status do banco local" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusOfflineDb}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="📤 Processar Outbox Agora"
                    Command="{Binding ProcessarOutboxCommand}" IsEnabled="{Binding Processando, Converter={StaticResource InverseBool}}"
                    Height="46" Background="{DynamicResource CorAcento}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="📦 Sincronizar Catálogo"
                    Command="{Binding SincronizarCatalogoCommand}" IsEnabled="{Binding Processando, Converter={StaticResource InverseBool}}"
                    Height="46" Background="#64748B" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>

            <Button Grid.Column="4" Content="↻" Command="{Binding AtualizarStatusCommand}"
                    Width="46" Height="46" Background="Transparent" BorderBrush="{DynamicResource BordaInput}" BorderThickness="1" Cursor="Hand"
                    ToolTip="Atualizar status"/>
        </Grid>

        <TextBlock Text="{Binding ResultadoTexto}" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextDark}"/>
    </StackPanel>
</UserControl>
