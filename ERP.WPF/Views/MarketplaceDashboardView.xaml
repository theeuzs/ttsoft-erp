<UserControl x:Class="ERP.WPF.Views.MarketplaceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource FundoGeral}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🛍️ Dashboard de Marketplace" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="{Binding LojasConectadasTexto}" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSelecionado}" Padding="8" Width="110" Margin="0,0,10,0"/>
                    <Button Content="↻ Atualizar" Command="{Binding AtualizarCommand}" Padding="12,8"
                            Background="{DynamicResource CorAcento}" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- PRIORIDADE 1 (confirmada com o dono do negócio) — "precisa de
                 atenção" sempre no topo, visível, clicável, nunca escondido
                 atrás de outra coisa. SKU não mapeado = gargalo real na
                 expedição da loja física. -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding PedidosAtencao, Converter={StaticResource ZeroToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding PedidosAtencao, StringFormat='⚠️ {0} pedido(s) precisam de atenção agora'}"
                               FontSize="16" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,4"/>
                    <TextBlock Text="SKU não mapeado ou conflito aberto — cada um aqui é um pedido travado na expedição. Clique pra resolver."
                               FontSize="12" Foreground="#7F1D1D" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding PrecisaAtencao}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold" FontSize="13">
                                                <Run Text="{Binding CanalNome}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding ExternalOrderId}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BuyerNickname}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding InternalStatus}" FontSize="10" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Resolva em Marketplace → SKU Mapping (SKU não mapeado) ou Marketplace → Pedidos (conflito)."
                               FontSize="11" FontStyle="Italic" Foreground="#991B1B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cards de resumo -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Pedidos no período" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding TotalPedidos}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Faturamento no período" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding FaturamentoTotal, StringFormat='R$ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <!-- PRIORIDADE 2 — Estoque Reservado com card próprio, não só
                     mais uma linha no gráfico. Volume preso = espaço físico
                     que a loja não vende no balcão enquanto isso. -->
                <Border Grid.Column="4" Background="#F5F3FF" BorderBrush="#C4B5FD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📦 Estoque Reservado (marketplace)" FontSize="12" Foreground="#6D28D9"/>
                        <TextBlock Text="{Binding EstoqueReservadoQtd}" FontSize="28" FontWeight="Bold" Foreground="#6D28D9"/>
                        <TextBlock Text="pedidos com produto preso, ainda não virou venda" FontSize="10" Foreground="#7C3AED" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Pedidos por status" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding StatusBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rotulo}" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="4" Height="18" VerticalAlignment="Center">
                                            <Border Background="{Binding Cor}" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding Quantidade, Converter={StaticResource IntToBarWidth}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantidade}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Faturamento por canal" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding FaturamentoPorCanal}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Faturamento, StringFormat='R$ {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#16A34A"/>
                                            <TextBlock Text="{Binding Pedidos, StringFormat='{}{0} pedido(s)'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
