<UserControl x:Class="ERP.WPF.Views.VendasXCustoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBgAlt}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Vendas x Custo" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="Vendas, custo e contas a receber pendentes, cruzados por mês"
                               FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="↻ Atualizar" Command="{Binding CarregarCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource CorAcento}" Foreground="White"
                        FontWeight="Bold" Height="34" Padding="16,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- Filtro de período -->
            <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Período: de" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding DataInicio}" Width="130" Margin="0,0,16,0"/>
                    <TextBlock Text="até" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding DataFim}" Width="130"/>
                </StackPanel>
            </Border>

            <!-- Cards -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="💰 VENDAS" FontSize="10" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="{Binding TotalVendas, StringFormat='R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#16A34A" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📦 CUSTO" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="{Binding TotalCusto, StringFormat='R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#DC2626" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="📊 LUCRO BRUTO" FontSize="10" FontWeight="Bold" Foreground="#3B82F6"/>
                        <TextBlock Text="{Binding TotalLucro, StringFormat='R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#3B82F6" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⏳ A RECEBER" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="{Binding TotalContasAReceber, StringFormat='R$ {0:N2}'}" FontSize="20" FontWeight="Black" Foreground="#F59E0B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Gráfico -->
            <Border Grid.Row="6" Background="{DynamicResource CardBg}" CornerRadius="12">
                <ContentControl x:Name="GraficoContainer" Margin="8"/>
            </Border>

            <!-- Tabela -->
            <Border Grid.Row="8" Background="{DynamicResource CardBg}" CornerRadius="12">
                <DataGrid ItemsSource="{Binding Periodos}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" RowHeight="40"
                          AlternatingRowBackground="{DynamicResource CardBgAlt}" CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Vendas" Binding="{Binding TotalVendas, StringFormat='R$ {0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="Custo" Binding="{Binding TotalCusto, StringFormat='R$ {0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="Lucro Bruto" Binding="{Binding LucroBruto, StringFormat='R$ {0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="Margem" Binding="{Binding MargemPercent, StringFormat='{}{0:N1}%'}" Width="90"/>
                        <DataGridTextColumn Header="A Receber (pendente)" Binding="{Binding ContasAReceberPendente, StringFormat='R$ {0:N2}'}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
