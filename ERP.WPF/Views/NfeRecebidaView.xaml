<UserControl x:Class="ERP.WPF.Views.NfeRecebidaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ERP.WPF.Controls"
             Background="{DynamicResource CardBgAlt}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="📥 Notas Recebidas (MD-e)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                <TextBlock Text="Notas de fornecedor emitidas contra o seu CNPJ — descobertas automaticamente, sem precisar pedir o XML por e-mail."
                           FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <controls:AmbienteFiscalBadge Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusTexto}" FontSize="12" Foreground="{DynamicResource CorAcento}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="🔍 Buscar Novas" Command="{Binding BuscarNovasCommand}"
                        Background="{DynamicResource CorAcento}" Foreground="White" FontWeight="Bold"
                        Padding="14,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="12">
            <DataGrid ItemsSource="{Binding Notas}" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="44"
                      AlternatingRowBackground="{DynamicResource CardBgAlt}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding NomeEmitente}" Width="*"/>
                    <DataGridTextColumn Header="CNPJ" Binding="{Binding CnpjEmitente}" Width="140"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataEmissao, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Valor" Binding="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" Width="120"/>
                    <DataGridTextColumn Header="Manifestação" Binding="{Binding StatusManifestacao}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Importada" Binding="{Binding Importada}" Width="80"/>

                    <DataGridTemplateColumn Header="Ações" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ciência" FontSize="11" Padding="8,5" Margin="0,0,4,0"
                                            Command="{Binding DataContext.DarCienciaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                    <Button Content="Confirmar" FontSize="11" Padding="8,5" Margin="0,0,4,0"
                                            Command="{Binding DataContext.ConfirmarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                    <Button Content="Desconhecer" FontSize="11" Padding="8,5" Margin="0,0,4,0" Foreground="#DC2626"
                                            Command="{Binding DataContext.DesconhecerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                    <Button Content="🗎 XML" FontSize="11" Padding="8,5" Background="#DBEAFE" Foreground="#1E40AF"
                                            Command="{Binding DataContext.BaixarXmlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
