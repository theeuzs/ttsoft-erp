<Window x:Class="ERP.WPF.Views.ExportarNotasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Notas Fiscais" Height="420" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource FundoGeral}">

    <Border Background="{DynamicResource CardBg}" CornerRadius="12" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.15" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="📦 Exportar Notas Fiscais" FontSize="20" FontWeight="Bold" Foreground="#1E62A6"/>
            <TextBlock Text="Baixa XML e/ou PDF de todas as notas do período, num ZIP só — ideal pra mandar pro contador."
                       FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,20"/>

            <TextBlock Text="Período" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" SelectedDate="{Binding DataInicio}"/>
                <DatePicker Grid.Column="2" SelectedDate="{Binding DataFim}"/>
            </Grid>

            <TextBlock Text="Incluir" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Content="XML" IsChecked="{Binding IncluirXml}" Margin="0,0,24,0" FontSize="14"/>
                <CheckBox Content="PDF" IsChecked="{Binding IncluirPdf}" FontSize="14"/>
            </StackPanel>

            <TextBlock Text="Salvar em" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding PastaDestino}" IsReadOnly="True"
                         Padding="8" BorderBrush="{DynamicResource BordaInput}" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="..." Command="{Binding EscolherPastaCommand}"
                        Width="40" BorderThickness="1" BorderBrush="{DynamicResource BordaInput}" Background="Transparent" Cursor="Hand"/>
            </Grid>

            <TextBlock Text="{Binding StatusTexto}" FontSize="12" Foreground="{DynamicResource CorAcento}"
                       Margin="0,0,0,12" HorizontalAlignment="Center"/>

            <Button Content="📦 Exportar ZIP" Command="{Binding ExportarCommand}"
                    IsEnabled="{Binding Exportando, Converter={StaticResource InverseBool}}"
                    Background="{DynamicResource CorAcento}" Foreground="White" FontWeight="Bold" FontSize="15"
                    Height="46" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>
