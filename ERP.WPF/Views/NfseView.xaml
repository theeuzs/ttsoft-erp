<UserControl x:Class="ERP.WPF.Views.NfseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBgAlt}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulário -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="🧾 Emitir NFS-e" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                <TextBlock Text="Nota Fiscal de Serviços Eletrônica — pra lojas que faturam montagem, instalação, frete como serviço, etc."
                           FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,20"/>

                <Border Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Tomador (cliente)" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Buscar cliente cadastrado" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding BuscaCliente, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"/>
                        <ListBox ItemsSource="{Binding ClientesSugestao}" SelectedItem="{Binding ClienteSelecionado}"
                                 DisplayMemberPath="Name" MaxHeight="120" Margin="0,0,0,10"/>

                        <TextBlock Text="Nome / Razão Social *" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding TomadorNome}" Padding="8" Margin="0,4,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPF/CNPJ" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding TomadorCpfCnpj}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="E-mail" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding TomadorEmail}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Endereço" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding TomadorEndereco}" Padding="8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Serviço" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Descrição do serviço *" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox Text="{Binding DescricaoServico}" Padding="8" Margin="0,4,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Código de Serviço (municipal)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding CodigoServico}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CNAE" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding CodigoCnae}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Valor do Serviço *" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding ValorServico}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alíquota ISS %" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding AliquotaISS}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Cód. Município (IBGE)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding CodigoMunicipio}" Padding="8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource CardBgAlt}" CornerRadius="6" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ValorIssCalculado, StringFormat='ISS: R$ {0:N2}'}" FontSize="13" Margin="0,0,20,0"/>
                                <TextBlock Text="{Binding ValorLiquidoCalculado, StringFormat='Líquido: R$ {0:N2}'}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusTexto}" FontSize="12" Foreground="{DynamicResource CorAcento}" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🗑 Limpar" Command="{Binding LimparCommand}" Height="46"
                            Background="Transparent" BorderBrush="{DynamicResource BordaInput}" BorderThickness="1" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="🚀 Emitir NFS-e" Command="{Binding EmitirCommand}" Height="46"
                            Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Histórico -->
            <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Notas Emitidas" FontSize="14" FontWeight="Bold"/>
                        <Button Content="↻" Command="{Binding AtualizarHistoricoCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding NotasEmitidas}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="40" MaxHeight="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tomador" Binding="{Binding TomadorNome}" Width="*"/>
                            <DataGridTextColumn Header="Nº" Binding="{Binding NumeroNfse}" Width="70"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataEmissao, StringFormat=dd/MM/yy}" Width="70"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding ValorServico, StringFormat='R$ {0:N2}'}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="PDF" FontSize="10" Padding="6,4" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.AbrirDanfseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Cursor="Hand"/>
                                            <Button Content="Cancelar" FontSize="10" Padding="6,4" Foreground="#DC2626"
                                                    Command="{Binding DataContext.CancelarNotaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
