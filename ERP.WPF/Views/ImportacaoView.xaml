<UserControl x:Class="ERP.WPF.Views.ImportacaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📥 Importar Dados do Sistema Anterior" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Traga seu catálogo de produtos e clientes (com saldo de fiado) de uma planilha CSV — sem digitar tudo de novo na mão."
                   Foreground="Gray" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="Produtos" IsChecked="{Binding TipoSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Produtos}"
                         GroupName="TipoImportacao" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <RadioButton Content="Clientes" IsChecked="{Binding TipoSelecionado, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Clientes}"
                         GroupName="TipoImportacao" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="📂 Selecionar Arquivo CSV..." Command="{Binding SelecionarArquivoCommand}"
                    Padding="12,6" Margin="20,0,0,0"/>
            <TextBlock Text="{Binding NomeArquivo}" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock Text="⏳ Processando..." Visibility="{Binding Processando, Converter={StaticResource BoolToVisibility}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>

            <StackPanel Visibility="{Binding TemPrevia, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Previa.TotalLinhas, StringFormat='Total: {0} linha(s)'}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Previa.TotalNovosRegistros, StringFormat='🆕 Novos: {0}'}" Foreground="Green" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Previa.TotalAtualizacoes, StringFormat='🔄 Atualiza: {0}'}" Foreground="DarkOrange" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Previa.TotalComErro, StringFormat='❌ Com erro: {0}'}" Foreground="Red"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding LinhasPreview}" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="450" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Linha" Binding="{Binding NumeroLinha}" Width="60"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="110"/>
                        <DataGridTextColumn Header="Resumo" Binding="{Binding Resumo}" Width="*"/>
                        <DataGridTextColumn Header="Erro" Binding="{Binding ErrosTexto}" Width="260" Foreground="Red"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Mostrando as primeiras 50 linhas — a validação já rodou em cima do arquivo inteiro."
                           Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="4" Content="✓ Confirmar Importação" Command="{Binding ConfirmarImportacaoCommand}"
                Padding="16,10" HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="#27AE60" Foreground="White" FontWeight="Bold"
                Visibility="{Binding TemPrevia, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
