<UserControl x:Class="ERP.WPF.Views.GerenciadorVendasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CardBgAlt}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Gerenciador de Vendas" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDark}"/>
                <TextBlock Text="Produto, classe, quantidade, custo e venda numa visão só"
                           FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="↻ Atualizar" Command="{Binding CarregarCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource CorAcento}" Foreground="White"
                    FontWeight="Bold" Height="34" Padding="16,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>

        <!-- Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="💰 TOTAL VENDIDO" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding TotalVendido, StringFormat='R$ {0:N2}'}"
                               FontSize="26" FontWeight="Black" Foreground="#16A34A" Margin="0,8,0,0"/>
                    <TextBlock Text="no período filtrado" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="📊 LUCRO TOTAL" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                    <TextBlock Text="{Binding TotalLucro, StringFormat='R$ {0:N2}'}"
                               FontSize="26" FontWeight="Black" Foreground="#3B82F6" Margin="0,8,0,0"/>
                    <TextBlock Text="venda menos custo" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="4" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding FiltroBusca, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="14" BorderBrush="{DynamicResource BordaInput}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="De:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding DataInicio}" Width="130"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding DataFim}" Width="130"/>
            </Grid>
        </Border>

        <!-- Tabela -->
        <Border Grid.Row="6" Background="{DynamicResource CardBg}" CornerRadius="12">
            <DataGrid ItemsSource="{Binding Itens}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      GridLinesVisibility="Horizontal" RowHeight="44"
                      AlternatingRowBackground="{DynamicResource CardBgAlt}" CanUserResizeRows="False">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="3*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Classe" Binding="{Binding Categoria}" Width="140"/>
                    <DataGridTextColumn Header="Qtd. Vendida" Binding="{Binding QuantidadeVendida, StringFormat='N2'}" Width="100"/>
                    <DataGridTextColumn Header="Custo Unit." Binding="{Binding CustoUnitario, StringFormat='R$ {0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="Custo Total" Binding="{Binding CustoTotal, StringFormat='R$ {0:N2}'}" Width="110"/>
                    <DataGridTextColumn Header="Venda Total" Binding="{Binding ValorVendaTotal, StringFormat='R$ {0:N2}'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#16A34A"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Lucro" Binding="{Binding LucroTotal, StringFormat='R$ {0:N2}'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Margem" Binding="{Binding MargemPercent, StringFormat='{}{0:N1}%'}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
